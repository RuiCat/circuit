# =============================================================================
# MCPU-8v2：可加载程序 8 位 CPU（扩展 ALU + 指令 RAM 加载）
# =============================================================================
# 端口：CLK + LOAD（1=加载程序 0=运行）+ LA[0:3]（加载地址）+ LD[0:7]（加载数据）
#       + Q[0:7]（ACC 输出观察）
# 指令集（OP[7:4] + ADDR[3:0]，S=OP 直接送 ALU）：
#   0000 LDA addr   A←RAM[addr]      0001 ADD addr  A←A+RAM[addr]
#   0010 SUB addr   A←A-RAM[addr]    0011 AND addr  A←A&RAM[addr]
#   0100 OR  addr   A←A|RAM[addr]    0101 XOR addr  A←A^RAM[addr]
#   0110 NOT        A←~A             0111 SHL       A←A<<1
#   1000 SHR        A←A>>1           1001 STA addr  RAM[addr]←A
#   1010 JMP addr   PC←addr
# 加载协议（LOAD=1）：每个 CLK 上升沿 指令RAM[LA]←LD；LA 由外部递增
#   加载完置 LOAD=0、CLK 继续 → 从地址 0 开始执行
# =============================================================================

.subckt fa A B CIN S COUT
U1 [A,B,t1] [5,5]
U2 [t1,CIN,S] [5,5]
U3 [A,B,t2] [1,5]
U4 [t1,CIN,t3] [1,5]
U5 [t2,t3,COUT] [3,5]
.ends fa

.subckt adder8 A[0:7] B[0:7] CIN S[0:7] COUT
X1 [A0,B0,CIN,S0,C1] fa
X2 [A1,B1,C1,S1,C2] fa
X3 [A2,B2,C2,S2,C3] fa
X4 [A3,B3,C3,S3,C4] fa
X5 [A4,B4,C4,S4,C5] fa
X6 [A5,B5,C5,S5,C6] fa
X7 [A6,B6,C6,S6,C7] fa
X8 [A7,B7,C7,S7,COUT] fa
.ends adder8

.subckt reg8 CLK D[0:7] Q[0:7]
DFF1 [CLK,D0,Q0,nq0]
R10 [nq0,-1] [10000]
DFF2 [CLK,D1,Q1,nq1]
R11 [nq1,-1] [10000]
DFF3 [CLK,D2,Q2,nq2]
R12 [nq2,-1] [10000]
DFF4 [CLK,D3,Q3,nq3]
R13 [nq3,-1] [10000]
DFF5 [CLK,D4,Q4,nq4]
R14 [nq4,-1] [10000]
DFF6 [CLK,D5,Q5,nq5]
R15 [nq5,-1] [10000]
DFF7 [CLK,D6,Q6,nq6]
R16 [nq6,-1] [10000]
DFF8 [CLK,D7,Q7,nq7]
R17 [nq7,-1] [10000]
.ends reg8

.subckt decoder4to16 X[0:3] Y[0:15]
U1 [X0,-1,nX0] [0,5]
