U54 [t14b,X3,Y14] [1,5]
U55 [X0,X1,t15a] [1,5]
U56 [t15a,X2,t15b] [1,5]
U57 [t15b,X3,Y15] [1,5]
.ends decoder4to16

.subckt sram_cell wl bl nbl q nq
U1 [bl,wl,s] [1,5]
U2 [nbl,wl,r] [1,5]
SR1 [s,r,q,nq] [5]
R3 [q,-1] [10000]
R4 [nq,-1] [10000]
.ends sram_cell

.subckt sram8 RW D[0:7] Q[0:7]
U3 [D0,-1,nD0] [0,5]
U4 [D1,-1,nD1] [0,5]
U5 [D2,-1,nD2] [0,5]
U6 [D3,-1,nD3] [0,5]
U7 [D4,-1,nD4] [0,5]
U8 [D5,-1,nD5] [0,5]
