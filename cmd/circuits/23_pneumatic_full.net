# =============================================================================
# 气路全套 (Pneumatic: PS + PR + PC + PL + PCV)
# =============================================================================
# 验证气路元件：气源 PS、气阻 PR、气容 PC、气感 PL、单向阀 PCV。
# 压力↔电压类比：气阻~电阻、气容~电容、气感~电感、气源~电压源。
#
# 电路结构:
#   PS1 (1atm) → PR1 → 节点2 → PC1(气容) 充电
#   PS1 → PCV1(单向阀) → 节点4 → PC2 充电（单向导通）
#
# 预期结果:
#   节点2 稳态 = 1atm = 101325 Pa（气容充满）
#   节点4 稳态 = 101325 Pa（单向阀正向导通）
#
# 运行命令:
#   circuit -t 0.1 --nodes 2,4 cmd/circuits/23_pneumatic_full.net
# =============================================================================

PS1 [1,-1] [101325]          # 气源 1atm = 101325 Pa
PR1 [1,2] [1e8]              # 气阻 1e8 Pa·s/m³
PC1 [2] [1e-8]               # 气容 1e-8 m³/Pa (单引脚+地)
PCV1 [1,4] [1e6,1e12,100]    # 单向阀: R_on=1e6, R_off=1e12, V_open=100Pa
PC2 [4] [1e-8]               # 气容
PL1 [4,5] [1e6]              # 气感 1e6 Pa·s²/m³
