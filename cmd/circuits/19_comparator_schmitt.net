# =============================================================================
# 比较器与施密特触发器 (Comparator & Schmitt Trigger)
# =============================================================================
# 验证模拟比较器 CMP 和施密特触发器 ST。
#
# CMP: vp > vn → 输出 V_high，否则 V_low。
# ST:  施密特滞回，输入超过 Vth_high 输出高，低于 Vth_low 输出低。
#
# 预期结果:
#   CMP(vp=5V > vn=2V) → node3 = 5V (高)
#   ST(vin=5V > Vth_high=3V) → node5 = 5V (高)
#
# 运行命令:
#   circuit -t 0.001 --nodes 3,5 cmd/circuits/19_comparator_schmitt.net
# =============================================================================

V1 [1,-1] [0,0,0,0,5]   # vp = 5V
V2 [2,-1] [0,0,0,0,2]   # vn = 2V (参考)

# 比较器: vp=1, vn=2, vout=3, V_high=5, V_low=0
CMP1 [1,2,3] [5,0]
R1 [3,-1] [10000]

# 施密特触发器: vin=1(5V), vout=5, V_high=5, V_low=0, Vth_high=3, Vth_low=1
ST1 [1,5] [5,0,3,1]
R2 [5,-1] [10000]
