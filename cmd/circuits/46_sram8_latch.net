# =============================================================================
# 8 位锁存器模块（sram8，复用 sram_cell 单 bit 单元）
# =============================================================================
# 端口：RW（读/写控制）+ D[0:7]（数据输入）+ Q[0:7]（数据输出）
#   RW=1：写入（Q = D）；RW=0：保持/读（Q 维持上次值）
# 每位数 = 一个 sram_cell（wl=RW, bl=D, nbl=¬D），nbl 由内部 NOT 生成
# =============================================================================

# 1 位存储单元（字线门控锁存）
.subckt sram_cell wl bl nbl q nq
U1 [bl,wl,s] [1,5]
U2 [nbl,wl,r] [1,5]
SR1 [s,r,q,nq] [5]
R3 [q,-1] [10000]
R4 [nq,-1] [10000]
.ends sram_cell

# 8 位锁存器
.subckt sram8 RW D[0:7] Q[0:7]
U3 [D0,-1,nD0] [0,5]
U4 [D1,-1,nD1] [0,5]
U5 [D2,-1,nD2] [0,5]
U6 [D3,-1,nD3] [0,5]
U7 [D4,-1,nD4] [0,5]
U8 [D5,-1,nD5] [0,5]
U9 [D6,-1,nD6] [0,5]
U10 [D7,-1,nD7] [0,5]
X1 [RW,D0,nD0,Q0,nq0] sram_cell
X2 [RW,D1,nD1,Q1,nq1] sram_cell
X3 [RW,D2,nD2,Q2,nq2] sram_cell
X4 [RW,D3,nD3,Q3,nq3] sram_cell
X5 [RW,D4,nD4,Q4,nq4] sram_cell
X6 [RW,D5,nD5,Q5,nq5] sram_cell
X7 [RW,D6,nD6,Q6,nq6] sram_cell
X8 [RW,D7,nD7,Q7,nq7] sram_cell
.ends sram8

# ---- 顶层演示 ----
V1 [vcc,-1] [0,0,0,0,5]
B1 [vcc,RW] [RW,0.5,1]
R1 [RW,-1] [10000]
B2 [vcc,D0] [D0,0.5,1]
R2 [D0,-1] [10000]
B3 [vcc,D1] [D1,0.5,1]
R3 [D1,-1] [10000]
B4 [vcc,D2] [D2,0.5,1]
R4 [D2,-1] [10000]
B5 [vcc,D3] [D3,0.5,1]
R5 [D3,-1] [10000]
B6 [vcc,D4] [D4,0.5,1]
R6 [D4,-1] [10000]
B7 [vcc,D5] [D5,0.5,1]
R7 [D5,-1] [10000]
B8 [vcc,D6] [D6,0.5,1]
R8 [D6,-1] [10000]
B9 [vcc,D7] [D7,0.5,1]
R9 [D7,-1] [10000]
X9 [RW,D[0:7],Q[0:7]] sram8
R10 [Q0,-1] [10000]
R11 [Q1,-1] [10000]
R12 [Q2,-1] [10000]
R13 [Q3,-1] [10000]
R14 [Q4,-1] [10000]
R15 [Q5,-1] [10000]
R16 [Q6,-1] [10000]
R17 [Q7,-1] [10000]
