# =============================================================================
# 多种电压源波形演示 (Voltage Source Waveform Demo)
# =============================================================================
# 展示电路仿真器支持的全部 7 种电压源波形。
# 每种波形驱动一个独立的 1kΩ 负载电阻，便于同时观测各节点电压。
#
# 波形参数格式: [波形类型, 偏置V, 频率Hz, 相位°, Vmax, 占空比]
#
# 波形类型:
#   0 = DC 直流
#   1 = AC 正弦波 (Sinusoidal)
#   2 = 方波 (Square Wave)
#   3 = 三角波 (Triangle Wave)
#   4 = 锯齿波 (Sawtooth) — rising
#   5 = 脉冲波 (Pulse)
#   6 = 噪声 (Noise)
#
# 运行命令:
#   circuit -t 0.04 --nodes 1,2,3,4,5 cmd/circuits/06_voltage_sources.net
# =============================================================================

# --- DC: 恒定 5V 直流 ---
V1 [1,-1] [0,0,0,0,5]
R1 [1,-1] [1000]

# --- AC: 50Hz 5V 振幅正弦波 ---
V2 [2,-1] [1,0,50,0,5,0.5]
R2 [2,-1] [1000]

# --- 方波: 100Hz 5V 振幅 ---
V3 [3,-1] [2,0,100,0,5,0.5]
R3 [3,-1] [1000]

# --- 三角波: 50Hz 5V 振幅 ---
V4 [4,-1] [3,0,50,0,5,0.5]
R4 [4,-1] [1000]

# --- 脉冲波: 1kHz 5V 振幅, 50% 占空比 ---
V5 [5,-1] [5,0,1000,0,5,0.5]
R5 [5,-1] [1000]
