# =============================================================================
# MCPU-8v3：4×8 寄存器组 CPU + RAM 统一内存（冯·诺依曼）+ 动态装载
# =============================================================================
# 端口：CLK + LOAD（1=装载程序 0=运行）+ LA[0:7]（装载地址）+ LD[0:7]（装载数据）
#       + LWE（装载写使能）+ Q[0:7]（R0 观察）
# 内存：RAM 元件（引擎 NodeType 47，256B）——程序与数据同址（冯·诺依曼）
# 寄存器：R0-R3（regfile4，4×8，全输出直连）
# 指令（8 位 OP[7:4]+Rd[3:2]+Rs[1:0]）：
#   0000 MOV Rd,Rs  0001 ADD Rd,Rs  0010 SUB Rd,Rs  0011 AND Rd,Rs
#   0100 OR Rd,Rs   0101 XOR Rd,Rs  0110 NOT Rd     0111 SHL Rd
#   1000 SHR Rd     1001 LD Rd,[R0] 1010 ST [R0],Rd 1011 JMP [R0]
# 装载（LOAD=1）：RAM[LA]←LD（LWE 高，CLK 边沿），CPU 冻结
# 运行（LOAD=0）：T=0 取指（PC→RAM→IR），T=1 执行（R0 作内存地址）
# =============================================================================

.subckt fa A B CIN S COUT
U1 [A,B,t1] [5,5]
U2 [t1,CIN,S] [5,5]
U3 [A,B,t2] [1,5]
U4 [t1,CIN,t3] [1,5]
U5 [t2,t3,COUT] [3,5]
.ends fa
.subckt adder8 A[0:7] B[0:7] CIN S[0:7] COUT
X1 [A0,B0,CIN,S0,C1] fa
X2 [A1,B1,C1,S1,C2] fa
X3 [A2,B2,C2,S2,C3] fa
X4 [A3,B3,C3,S3,C4] fa
X5 [A4,B4,C4,S4,C5] fa
X6 [A5,B5,C5,S5,C6] fa
X7 [A6,B6,C6,S6,C7] fa
X8 [A7,B7,C7,S7,COUT] fa
.ends adder8
.subckt reg8 CLK D[0:7] Q[0:7]
DFF1 [CLK,D0,Q0,nq0]
R10 [nq0,-1] [10000]
DFF2 [CLK,D1,Q1,nq1]
R11 [nq1,-1] [10000]
DFF3 [CLK,D2,Q2,nq2]
R12 [nq2,-1] [10000]
DFF4 [CLK,D3,Q3,nq3]
R13 [nq3,-1] [10000]
DFF5 [CLK,D4,Q4,nq4]
R14 [nq4,-1] [10000]
DFF6 [CLK,D5,Q5,nq5]
R15 [nq5,-1] [10000]
DFF7 [CLK,D6,Q6,nq6]
R16 [nq6,-1] [10000]
DFF8 [CLK,D7,Q7,nq7]
R17 [nq7,-1] [10000]
.ends reg8
