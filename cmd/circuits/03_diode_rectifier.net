# =============================================================================
# 二极管半波整流器 (Diode Half-Wave Rectifier)
# =============================================================================
# 含非线性元件（二极管）的电路，展示半波整流原理。
# 交流正弦波输入，二极管只允许正向电流通过，负载上得到半波脉动直流。
#
# 电路结构:
#   V1 (AC 50Hz 5V正弦) ---+---[D1 正向]---+---[R1 1kΩ]--- GND (-1)
#                          |               |
#                        node 1         node 2 (整流输出)
#
# 工作原理:
#   正半周 (Vin > 0): 二极管正向导通，Vout ≈ Vin - Vf（Vf ≈ 0.7V）
#   负半周 (Vin < 0): 二极管反向截止，Vout ≈ 0V
#   输出为只有正半周的脉动直流波形
#
# 输入参数:
#   波形=1(AC正弦), 频率=50Hz, Vmax=5V, duty=0.5
#   周期 T = 1/50Hz = 20ms
#
# 预期结果:
#   节点 1 = 5V 振幅 50Hz 正弦波
#   节点 2 = 半波整流波形，正半周约 4.3V 峰值，负半周接近 0V
#
# 运行命令:
#   circuit -t 0.04 cmd/circuits/03_diode_rectifier.net
# =============================================================================

V1 [1,-1] [1,0,50,0,5,0.5]  # AC 50Hz 5V 正弦电压源: 波形=1(正弦), 偏置=0, 频率=50Hz, 相位=0, Vmax=5, duty=0.5
D1 [1,2] [true]               # 二极管正向偏置: 阳极=节点1, 阴极=节点2, 正向=true
R1 [2,-1] [1000]              # 负载电阻 1kΩ: 整流电流通路
