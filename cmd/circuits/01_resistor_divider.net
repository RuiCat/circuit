# =============================================================================
# 电阻分压器 (Resistor Divider)
# =============================================================================
# 最简单的纯电阻电路，用于验证仿真器基本直流分析功能。
# 两个电阻串联在 5V DC 电压源和地之间，中间节点输出分压。
#
# 电路结构:
#   V1 (5V DC) ---+---[R1 1kΩ]---+---[R2 2kΩ]--- GND (-1)
#                 |               |
#               node 1         node 2
#
# 预期结果:
#   节点 1 电压 = 5V (电源电压)
#   节点 2 电压 = 5 * 2000 / (1000 + 2000) = 3.333V (分压公式)
#
# 运行命令:
#   circuit -t 0.001 cmd/circuits/01_resistor_divider.net
# =============================================================================

V1 [1,-1] [0,0,0,0,5]    # DC 5V 电压源: 波形=0(DC), 偏置=0, 频率=0, 相位=0, Vmax=5
R1 [1,2] [1000]           # 上拉电阻: 1kΩ，连接节点1(高)和节点2(输出)
R2 [2,-1] [2000]          # 下拉电阻: 2kΩ，连接节点2和地(-1)
