# =============================================================================
# LED 驱动电路 (LED Driver)
# =============================================================================
# 发光二极管串联限流电阻，验证 LED 元件。
# LED 正向导通时两端压降约 Vf，电流由限流电阻决定。
#
# 电路结构:
#   V1 (5V) ---+---[R1 220Ω]---+--- node 2
#               |               |
#             node 1        [LED1 anode=2, cathode=-1]
#                               |
#                             GND (-1)
#
# LED 参数 (Is,Vz,N,Rs; Vz=0 无齐纳):
#   Is=1e-18, Vz=0, N=1.5, Rs=5, 典型 Vf≈2V
#
# 预期结果:
#   node 2 ≈ LED 正向压降 ≈ 1.5V（由 Is/N/Rs 伏安特性决定，非固定 2V）
#   电流 ≈ (5 - 1.5) / 220 ≈ 16mA
#
# 运行命令:
#   circuit -t 0.001 --nodes 2 cmd/circuits/16_led_driver.net
# =============================================================================

V1 [1,-1] [0,0,0,0,5]        # 5V 电源
R1 [1,2] [220]               # 限流电阻 220Ω
LED1 [2,-1] [1e-18,0,1.5,5]  # LED: anode=2, cathode=-1; Is=1e-18, Vz=0, N=1.5, Rs=5
