# =============================================================================
# 液压回路 (Hydraulic: HP + HR + HA + HL + HCV)
# =============================================================================
# 验证液压元件：液压泵 HP、液阻 HR、蓄能器 HA、液感 HL、单向阀 HCV。
# 压力↔电压类比：液阻~电阻、蓄能器~电容、液感~电感、泵~电压源。
#
# 电路结构:
#   HP1 (10MPa) → HR1 → 节点2 → HA1(蓄能器) 充压
#   HP1 → HCV1(单向阀) → 节点4 → HA2 充压
#
# 预期结果:
#   节点2 稳态 = 10MPa = 1e7 Pa（蓄能器充满）
#   节点4 稳态 = 1e7 Pa（单向阀正向导通）
#
# 运行命令:
#   circuit -t 0.1 --nodes 2,4 cmd/circuits/24_hydraulic_circuit.net
# =============================================================================

HP1 [1,-1] [10e6]            # 液压泵 10MPa = 1e7 Pa
HR1 [1,2] [1e8]              # 液阻 1e8 Pa·s/m³
HA1 [2] [1e-8]               # 蓄能器 1e-8 m³/Pa (单引脚+油箱)
HCV1 [1,4] [1e6,1e12,1e6]    # 单向阀: R_on=1e6, R_off=1e12, V_open=1e6Pa
HA2 [4] [1e-8]               # 蓄能器
HL1 [4,5] [1e6]              # 液感 1e6 Pa·s²/m³
