# 混合物理域测试网表：电气-气动-液压跨域仿真
# 测试场景：电压源驱动电气-气动转换器(EP)产生气压，
# 气路通过气阻(PR)和气容(PC)形成RC网络，
# 压力传感器(PSENS)将气压反馈为电压信号。

# 电气部分：10V直流电源
V1 [1, 0] [0, 0, 0, 0, 10]
# 负载电阻
R1 [1, 2] [1000]

# 电气-气动转换器：V(1,0) → 气路压力，gain=100000 (1V→100kPa)
EP1 [1, 0] [3, 0] [100000]

# 气路部分：气阻+气容形成气路RC
PR1 [3, 4] [1e8]
PC1 [4] [1e-8]

# 压力传感器：读取气路压力 → 电压信号，gain=1e-4 (100kPa→10V)
PSENS1 [4, 0] [5, 0] [1e-4, 0, 0]

# 输出电阻
R2 [5, 0] [10000]

# 仿真参数
.value t_max 0.5
.value t_step 1e-5
