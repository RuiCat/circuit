# =============================================================================
# 逻辑门 (Logic Gates)
# =============================================================================
# 验证原生逻辑门 U 元件：AND、NOT、OR、XOR。
# 门类型: 0=NOT(反相), 1=AND, 2=NAND, 3=OR, 4=NOR, 5=XOR
#
# 预期结果:
#   AND(5V,5V) → node3 = 5V
#   NOT(0V)    → node5 = 5V
#   OR(5V,0V)  → node8 = 5V
#   XOR(5V,5V) → node11 = 0V
#
# 运行命令:
#   circuit -t 0.001 cmd/circuits/17_logic_gates.net
# =============================================================================

# 输入电压源
V1 [1,-1] [0,0,0,0,5]   # A = 5V (高)
V2 [2,-1] [0,0,0,0,5]   # B = 5V (高)
V3 [6,-1] [0,0,0,0,0]   # C = 0V (低)

# AND 门: A AND B = 5 AND 5 = 高
U1 [1,2,3] [1,5]        # type=1(AND), V_high=5
R1 [3,-1] [10000]

# NOT 门: NOT(地=0V) = 高
U2 [-1,-1,5] [0,5]      # type=0(NOT)
R2 [5,-1] [10000]

# OR 门: A OR C = 5 OR 0 = 高
U3 [1,6,8] [3,5]        # type=3(OR)
R3 [8,-1] [10000]

# XOR 门: A XOR B = 5 XOR 5 = 低
U4 [1,2,11] [5,5]       # type=5(XOR)
R4 [11,-1] [10000]
