# =============================================================================
# 65 恒流 LED 驱动模块（生产级指示灯/背光偏置，齐纳基准 + 射极负反馈）
# =============================================================================
# 结构：V1(12V) --(R1 4.7k)-- node2（基极 = 齐纳基准）
#                            Z1 2.4V 齐纳到地
#        Q1：B=node2, C=node3, E=node4
#        R3 射极电阻 100Ω（恒流设定，负反馈）
#        LED1：阳极=V1，阴极=node3
#
# 生产用途：以**齐纳基准**设定 LED 电流，使电流与电源电压解耦
# （对比：用电阻分压偏置时电流会随电源近似同比例漂移——
#   实测 12V→14V 时电流 +24%，不满足恒流要求，故本模块改用齐纳基准）。
#   I = (Vz − Vbe)/R3 = (2.4 − 0.7)/100 ≈ 17mA，电源变化只通过齐纳动态电阻（≈2Ω）
#   与晶体管 Early 效应轻微影响，实测 ΔI < 1%。
#
# 规格（见 cmd/productionModules_test.go）：
#   S1 设定电流：I ≈ 17mA，实测须在 15.3~18.7mA（±10%）
#   S2 电源抑制：电源 12V→14V 时 ΔI < 3%
#   S3 LED 正向导通：Vf ≈ 1.5V（node3 ≈ V1 − Vf）
# =============================================================================
V1 [1,-1] [0,0,0,0,12]       # 12V 电源（测试改为 14V 验证恒流）
R1 [1,2] [4700]              # 齐纳偏置电阻（Iz ≈ (12−2.4)/4.7k ≈ 2mA）
Z1 [-1,2] [1e-14,2.4,1,0.1]  # 2.4V 齐纳基准（阴极=node2）
Q1 [2,3,4] [false,100]       # NPN：B=2, C=3, E=4，β=100
R3 [4,-1] [100]              # 射极电阻 100Ω（恒流设定与负反馈）
LED1 [1,3] [1e-18,0,1.5,5]   # LED：阳极=V1，阴极=node3（Is=1e-18, N=1.5, Rs=5）
