# =============================================================================
# 运放同相放大器 (Op-Amp Non-Inverting Amplifier)
# =============================================================================
# 利用运算放大器构建同相比例放大电路。
# 理想运放"虚短虚断"特性：同相端电压≈反相端电压，输入端电流≈0。
#
# 电路结构:
#   V1 (1V DC) ---+--- node 1 (Vin, 同相输入端+)
#                 |
#   opamp1 同相端(+) = node 1
#   opamp1 反相端(-) = node 2 (虚短: V2 ≈ V1 = 1V)
#   opamp1 输出端    = node 3
#
#   反馈网络:
#     R1: node 2 --- GND (-1) [1kΩ]
#     R2: node 2 --- node 3    [2kΩ]
#
# 增益计算:
#   由虚短: V2 = V1 = 1V
#   由虚断: 流过 R1 的电流 = 流过 R2 的电流
#   V2 / R1 = (Vout - V2) / R2
#   1/1000 = (Vout - 1)/2000
#   Vout = 1 + 1 × (2000/1000) = 3V
#
#   同相放大增益公式: Av = 1 + R2/R1 = 1 + 2000/1000 = 3
#
# 预期结果:
#   节点 1 = 1V (输入)
#   节点 2 ≈ 1V (虚短)
#   节点 3 ≈ 3V (输出 = 输入 × 增益)
#
# 运行命令:
#   circuit -t 0.001 cmd/circuits/05_opamp_amplifier.net
# =============================================================================

V1 [1,-1] [0,0,0,0,1]          # 输入信号 1V DC: 同相输入端电压
R1 [2,-1] [1000]                # R1=1kΩ: 反相端到地的反馈电阻
R2 [2,3] [2000]                 # R2=2kΩ: 反相端到输出的反馈电阻
opamp1 [1,2,3] [15,-15,1e5]    # 运放: 同相=节点1, 反相=节点2, 输出=节点3; V+=15V, V-=-15V, 开环增益=1e5
