# =============================================================================
# 16×8 指令 ROM（rom16x8，译码器 + 二极管/OR 阵列）
# =============================================================================
# 端口：A[0:3]（4 位地址，来自 PC 低 4 位）+ Y[0:7]（8 位指令输出）
# 结构：decoder4to16 地址译码 → 16 条字线 WL0..WL15
#       OR 阵列：每根位线 Y_i = 所有存储位 i 为 1 的字线 OR
#       （等效二极管 ROM：字线高 → 位线被拉高，未存 1 的位线经下拉为 0）
# 存储内容（MCPU-8 测试程序，位序 bit7..bit0）：
#   W0 = 0000 0101 (0x05)  LDA 5    A ← RAM[5]
#   W1 = 0100 0110 (0x46)  ADD 6    A ← A + RAM[6]
#   W2 = 1000 0111 (0x87)  STA 7    RAM[7] ← A
#   W3 = 1100 0011 (0xC3)  JMP 3    PC ← 3（死循环）
#   W4..W15 = 0（未用）
# 位线方程（只列含 1 的）：
#   Y0 = W0+W2+W3      （W0/W2/W3 bit0=1）
#   Y1 = W2+W3         （W2/W3 bit1=1）
#   Y2 = W0+W1+W2      （W0/W1/W2 bit2=1）
#   Y3 = 0, Y4 = 0, Y5 = 0
#   Y6 = W1+W3         （W1/W3 bit6=1）
#   Y7 = W2+W3         （W2/W3 bit7=1）
# =============================================================================

# ---- 4→16 译码器 decoder4to16（同 44/47）----
.subckt decoder4to16 X[0:3] Y[0:15]
U1 [X0,-1,nX0] [0,5]
U2 [X1,-1,nX1] [0,5]
U3 [X2,-1,nX2] [0,5]
U4 [X3,-1,nX3] [0,5]
U5 [nX0,nX1,t0a] [1,5]
U6 [t0a,nX2,t0b] [1,5]
U7 [t0b,nX3,Y0] [1,5]
U8 [X0,nX1,t1a] [1,5]
U9 [t1a,nX2,t1b] [1,5]
U10 [t1b,nX3,Y1] [1,5]
U11 [nX0,X1,t2a] [1,5]
U12 [t2a,nX2,t2b] [1,5]
U13 [t2b,nX3,Y2] [1,5]
U14 [X0,X1,t3a] [1,5]
U15 [t3a,nX2,t3b] [1,5]
U16 [t3b,nX3,Y3] [1,5]
U17 [nX0,nX1,t4a] [1,5]
U18 [t4a,X2,t4b] [1,5]
U19 [t4b,nX3,Y4] [1,5]
U20 [X0,nX1,t5a] [1,5]
U21 [t5a,X2,t5b] [1,5]
U22 [t5b,nX3,Y5] [1,5]
U23 [nX0,X1,t6a] [1,5]
U24 [t6a,X2,t6b] [1,5]
U25 [t6b,nX3,Y6] [1,5]
U26 [X0,X1,t7a] [1,5]
U27 [t7a,X2,t7b] [1,5]
U28 [t7b,nX3,Y7] [1,5]
U29 [nX0,nX1,t8a] [1,5]
U30 [t8a,nX2,t8b] [1,5]
U31 [t8b,X3,Y8] [1,5]
U32 [X0,nX1,t9a] [1,5]
U33 [t9a,nX2,t9b] [1,5]
U34 [t9b,X3,Y9] [1,5]
U35 [nX0,X1,t10a] [1,5]
U36 [t10a,nX2,t10b] [1,5]
U37 [t10b,X3,Y10] [1,5]
U38 [X0,X1,t11a] [1,5]
U39 [t11a,nX2,t11b] [1,5]
U40 [t11b,X3,Y11] [1,5]
U41 [nX0,nX1,t12a] [1,5]
U42 [t12a,X2,t12b] [1,5]
U43 [t12b,X3,Y12] [1,5]
U44 [X0,nX1,t13a] [1,5]
U45 [t13a,X2,t13b] [1,5]
U46 [t13b,X3,Y13] [1,5]
U47 [nX0,X1,t14a] [1,5]
U48 [t14a,X2,t14b] [1,5]
U49 [t14b,X3,Y14] [1,5]
U50 [X0,X1,t15a] [1,5]
U51 [t15a,X2,t15b] [1,5]
U52 [t15b,X3,Y15] [1,5]
.ends decoder4to16

# ---- 16×8 指令 ROM ----
# X1：译码器；U100+：位线 OR 阵列；R20..R27：位线下拉（未存 1 的位明确为 0）
.subckt rom16x8 A[0:3] Y[0:7]
X1 [A[0:3],WL[0:15]] decoder4to16
# Y0 = W0+W2+W3
U100 [WL0,WL2,t0a] [3,5]
U101 [t0a,WL3,Y0] [3,5]
# Y1 = W1+W2+W3
U102 [WL1,WL2,t1a] [3,5]
U107 [t1a,WL3,Y1] [3,5]
# Y2 = W0+W1+W2
U103 [WL0,WL1,t2a] [3,5]
U104 [t2a,WL2,Y2] [3,5]
# Y3 = 0（无二极管）
# Y4 = 0
# Y5 = 0
# Y6 = W1+W3
U105 [WL1,WL3,Y6] [3,5]
# Y7 = W2+W3
U106 [WL2,WL3,Y7] [3,5]
R20 [Y0,-1] [10000]
R21 [Y1,-1] [10000]
R22 [Y2,-1] [10000]
R23 [Y3,-1] [10000]
R24 [Y4,-1] [10000]
R25 [Y5,-1] [10000]
R26 [Y6,-1] [10000]
R27 [Y7,-1] [10000]
.ends rom16x8

# =============================================================================
# 顶层演示 —— 地址开关驱动 rom16x8
# =============================================================================
# V1：5V 电源；B1..B4：A0..A3 地址开关；R1..R4：下拉
# X1：实例化 rom16x8，Y0..Y7 为指令输出（读顶层节点）
# 验证：A=0 → Y=0x05；A=1 → 0x46；A=2 → 0x87；A=3 → 0xC3
# =============================================================================
V1 [vcc,-1] [0,0,0,0,5]
B1 [vcc,A0] [A0,0.5,1]
R1 [A0,-1] [10000]
B2 [vcc,A1] [A1,0.5,1]
R2 [A1,-1] [10000]
B3 [vcc,A2] [A2,0.5,1]
R3 [A2,-1] [10000]
B4 [vcc,A3] [A3,0.5,1]
R4 [A3,-1] [10000]
X1 [A[0:3],Y[0:7]] rom16x8
R10 [Y0,-1] [10000]
R11 [Y1,-1] [10000]
R12 [Y2,-1] [10000]
R13 [Y3,-1] [10000]
R14 [Y4,-1] [10000]
R15 [Y5,-1] [10000]
R16 [Y6,-1] [10000]
R17 [Y7,-1] [10000]
