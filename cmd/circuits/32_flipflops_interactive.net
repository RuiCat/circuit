# =============================================================================
# 触发器交互演示 (Interactive Flip-Flops: SR / DFF / JK / T)
# =============================================================================
# SR 锁存器 + D 触发器 + JK 触发器 + T 触发器，全部用开关控制输入。
#
# 操作 (circuit interactive cmd/circuits/32_flipflops_interactive.net):
#   > step                     ← 先 step 一次初始化
#   --- SR 锁存器 (Q=3, NQ=4) ---
#   > set S_IN 1 ; step        ← 置位 → Q=5V
#   > set S_IN 0 ; step
#   > set R_IN 1 ; step        ← 复位 → Q=0V
#   --- DFF (CLK=node10 1kHz, D=5, Q=6) ---
#   > set D_IN 1 ; step        ← D=1，等待时钟上升沿采样
#   --- JK (J=8, K=9, Q=11) ---
#   > set J_IN 1 ; step        ← J=1,K=0 → 置位
#   --- T (T=13, Q=15) ---
#   > set T_IN 1 ; step        ← T=1 → 每时钟翻转
# =============================================================================

V1 [100,-1] [0,0,0,0,5]

# ============ SR 锁存器 ============
B1 [100,1] [S_IN,0.5,1]
R1 [1,-1] [10000]
B2 [100,2] [R_IN,0.5,1]
R2 [2,-1] [10000]
SR1 [1,2,3,4] [5]              # SR 锁存器: S=1置位, R=1复位
R3 [3,-1] [10000]
R4 [4,-1] [10000]

# ============ D 触发器 ============
V2 [10,-1] [5,0,1000,0,5,0.5]   # 1kHz 脉冲时钟
B3 [100,5] [D_IN,0.5,1]
R5 [5,-1] [10000]
DFF1 [10,5,6,7] [5]            # DFF: clk=10, d=5, q=6, nq=7
R6 [6,-1] [10000]
R7 [7,-1] [10000]

# ============ JK 触发器 ============
B4 [100,8] [J_IN,0.5,1]
R8 [8,-1] [10000]
B5 [100,9] [K_IN,0.5,1]
R9 [9,-1] [10000]
JK1 [8,9,10,11,12] [5]         # JK: j=8, k=9, clk=10, q=11, nq=12
R11 [11,-1] [10000]
R12 [12,-1] [10000]

# ============ T 触发器 ============
B6 [100,13] [T_IN,0.5,1]
R13 [13,-1] [10000]
T1 [13,10,15,16] [5]           # T: t=13, clk=10, q=15, nq=16
R15 [15,-1] [10000]
R16 [16,-1] [10000]
