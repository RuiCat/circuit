# =============================================================================
# JK 触发器时序测试 — 基础逻辑门 + SR 锁存器构建版
# =============================================================================
# 结构：主从 JK（Master-Slave），U 门做全部 JK 译码逻辑，SR 锁存器存储状态。
#   主锁存器（CLK 高时跟随 J/K，反馈 NQ/Q 实现 J=K=1 翻转）:
#     U1: S1  = AND(J, CLK, NQ)          # 主置位端
#     U2: R1  = AND(K, CLK, Q)           # 主复位端
#     SR1 [S1,R1] → MQ / MNQ             # 主锁存器
#   时钟反相: U3: NCLK = NOT CLK
#   从锁存器（CLK 低时采样主锁存器）:
#     U4: S2  = AND(MQ, NCLK)            # 从置位端
#     U5: R2  = AND(MNQ, NCLK)           # 从复位端
#     SR2 [S2,R2] → Q / NQ               # 从锁存器
#
# 真值表（V_high=5V）:
#   J=0 K=0 → 保持;  J=1 K=0 → 置位(Q=1);  J=0 K=1 → 复位(Q=0);  J=1 K=1 → 翻转
#
# 说明：引擎无门传播延迟模型（同步更新），交叉耦合/门控信号的传播
#   按时间步离散化——本结构下 Q 在 CLK 的每个边沿（上升+下降）采样更新，
#   J=K=1 时每时钟周期翻转 2 次（等效 2 倍频 T 触发）。保持/置位/复位为
#   电平行为，与标准 JK 一致。
#
# 时钟: V2 为 1kHz 脉冲波（50% 占空比），边沿位于 t=0.5ms + k*0.5ms
# J/K: 事件开关 B1/B2 接 VCC(5V)，闭合=1，断开=0（10kΩ 下拉）
#
# 测试序列（每段推进 2.5ms = 5 个时钟边沿，奇数个采样点保证可判定状态）:
#   段0  J=0 K=1  推进 2.5ms → Q=0（从任意初始态复位）
#   段1  J=0 K=0  推进 2.5ms → Q=0（保持 0）
#   段2  J=1 K=0  推进 2.5ms → Q=1（置位）
#   段3  J=0 K=1  推进 2.5ms → Q=0（复位）
#   段4  J=1 K=1  推进 2.5ms → Q=1（翻转 0→1）
#   段5  J=1 K=1  推进 2.5ms → Q=0（再翻转 1→0）
#   段6  J=1 K=0  推进 2.5ms → Q=1（置位，最后确认）
#
# 输出: Q=节点13, NQ=节点12, CLK=节点10, 主Q=节点5, 主NQ=节点6
# =============================================================================

V1 [100,-1] [0,0,0,0,5]           # VCC 5V
V2 [10,-1]  [5,0,1000,0,5,0.5]    # 1kHz 脉冲时钟（50% 占空比）

B1 [100,1] [J_EVT,0.5,1]          # J 输入事件开关（J_EVT=1 闭合 → J=5V）
R1 [1,-1]  [10000]                # J 节点下拉
B2 [100,2] [K_EVT,0.5,1]          # K 输入事件开关（K_EVT=1 闭合 → K=5V）
R2 [2,-1]  [10000]                # K 节点下拉

# ============ 主锁存器门控（CLK 高时跟随） ============
U1 [1,10,12,3] [1,5]              # S1 = AND(J, CLK, NQ)   → 节点3
U2 [2,10,13,4] [1,5]              # R1 = AND(K, CLK, Q)    → 节点4
SR1 [3,4,5,6] [5]                 # 主锁存器: MQ=节点5, MNQ=节点6

# ============ 时钟反相 ============
U3 [10,7]      [0,5]              # NCLK = NOT CLK         → 节点7

# ============ 从锁存器门控（CLK 低时采样） ============
U4 [5,7,8]     [1,5]              # S2 = AND(MQ, NCLK)     → 节点8
U5 [6,7,9]     [1,5]              # R2 = AND(MNQ, NCLK)    → 节点9
SR2 [8,9,13,12] [5]               # 从锁存器: Q=节点13, NQ=节点12
