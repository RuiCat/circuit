# =============================================================================
# 61 3.3V 线性稳压模块（齐纳基准 + NPN 射极跟随，生产级小电流 LDO）
# =============================================================================
# 结构：V1 --(R1 偏置)-- node2（齐纳基准）-- Q1 基极
#        Q1：B=node2, C=V1(输入), E=node3（输出）
#        输出电容 C1 + 负载 R2
#
# 生产用途：给 MCU/传感器供 3.3V 的小电流（<50mA）低成本稳压；
# 齐纳提供基准，射极跟随提供电流增益与低输出阻抗。
#
# 规格（见 cmd/productionModules_test.go）：
#   S1 标称：Vin=5V、负载 1kΩ → 输出 3.15~3.35V
#   S2 线性调整率：Vin 5V→8V，ΔVout < 30mV
#   S3 负载调整率：负载 1kΩ→100Ω（Iout 3.2mA→32mA），ΔVout < 150mV
# =============================================================================
V1 [1,-1] [0,0,0,0,5]        # 输入 5V（测试改为 8V 验证线性调整率）
R1 [1,2] [1000]              # 齐纳偏置电阻（Iz≈1.1mA）
Z1 [-1,2] [1e-14,3.9,1,0.1]  # 3.9V 齐纳基准（阴极=node2）
Q1 [2,1,3] [false,100]       # NPN 射极跟随：B=2, C=1(Vin), E=3(Vout)
C1 [3,-1] [1e-6]             # 输出电容（稳定与瞬态）
R2 [3,-1] [1000]             # 负载 1kΩ（测试改为 100Ω 验证负载调整率）
