# =============================================================================
# 开关 (Switches)
# =============================================================================
# 验证普通开关 sw 元件：state 参数控制通断。
# 开关参数: state(0=关,1=开), R_on(导通电阻), R_off(关断电阻)
#
# 预期结果:
#   SW1 闭合(state=1): node2 ≈ 5V（导通，R1 分压）
#   SW2 断开(state=0): node3 ≈ 0V（关断，1e12Ω 近似开路）
#
# 运行命令:
#   circuit -t 0.001 --nodes 2,3 cmd/circuits/20_switches.net
# =============================================================================

V1 [1,-1] [0,0,0,0,5]      # 5V 电源
SW1 [1,2] [1,1e-6,1e12]    # 开关闭合: state=1, R_on=1e-6, R_off=1e12
R1 [2,-1] [1000]           # 负载 1kΩ
SW2 [1,3] [0,1e-6,1e12]    # 开关断开: state=0
R2 [3,-1] [1000]           # 负载 1kΩ
