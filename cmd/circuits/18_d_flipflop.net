# =============================================================================
# D 触发器 (D Flip-Flop)
# =============================================================================
# 验证原生 D 触发器 DFF 元件：时钟上升沿采样 D 输入。
# D 输入恒为高(5V)，时钟为方波脉冲，验证边沿采样行为。
#
# 电路结构:
#   D = 节点1 (恒 5V)
#   CLK = 节点2 (方波 100Hz)
#   DFF1 [clk=2, d=1, q=3, nq=4]
#
# 预期结果:
#   时钟上升沿后 Q 采样 D=5V → Q(节点3) = 5V, NQ(节点4) = 0V
#
# 运行命令:
#   circuit -t 0.02 --nodes 3,4 cmd/circuits/18_d_flipflop.net
# =============================================================================

V1 [1,-1] [0,0,0,0,5]       # D 输入恒高 5V
V2 [2,-1] [5,0,100,0,5,0.5] # CLK 方波 100Hz (波形=5脉冲)
DFF1 [2,1,3,4] [5]          # DFF: clk=2, d=1, q=3, nq=4, V_high=5
R1 [3,-1] [10000]           # Q 负载
R2 [4,-1] [10000]           # NQ 负载
