# =============================================================================
# 电气-液压转换器 (Electro-Hydraulic Converter)
# =============================================================================
# 验证 EH 元件：电压信号转换为液压压力。
# EH: Pout = gain × (Vin+ - Vin-)，默认 gain=1MPa/V。
#
# 电路结构:
#   V1 (10V) → EH1 输入 (in+=1, in-=-1)
#   EH1 输出液压 (pout+=3, pout-=-1) → HA1 蓄能器
#
# 预期结果:
#   Pout = gain(1e6) × 10V = 1e7 Pa = 10MPa → node3 ≈ 1e7
#
# 运行命令:
#   circuit -t 0.001 --nodes 3 cmd/circuits/26_eh_converter.net
# =============================================================================

V1 [1,-1] [0,0,0,0,10]      # 10V 电源
EH1 [1,-1,3,-1] [1e6,0]     # 电气-液压: in+=1, in-=-1, pout+=3, pout-=-1; gain=1e6
HA1 [3] [1e-8]              # 液压蓄能器(单引脚+油箱)
