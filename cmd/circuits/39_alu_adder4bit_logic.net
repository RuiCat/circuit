# =============================================================================
# 4 位行波进位加法器 (CPU 组件: ALU 加法, 逻辑实现) — 交互测试
# =============================================================================
# CPU ALU 的 8 位行波进位加法器（取低 4 位演示）：
#   每级 FA: S=A⊕B⊕Cin, Cout=A·B+Cin·(A⊕B)，进位链 C0→C1→C2→C3→C4
#
# 操作:
#   > step
#   > set A0 1 ; set B0 1 ; step       → S0(50)=0, C1=1
#   > set A1 1 ; step                  → S1(51)=0, C2=1（0110+1...）
#   完整验证: A=0110, B=0011, Cin=0 → S=1001, C4=0
#   (A0=0,A1=1,A2=1,A3=0; B0=1,B1=1,B2=0,B3=0)
# =============================================================================

V1 [100,-1] [0,0,0,0,5]

# 输入开关 A0-A3, B0-B3, Cin
B1 [100,10] [A0,0.5,1]
R10 [10,-1] [10000]
B2 [100,11] [A1,0.5,1]
R11 [11,-1] [10000]
B3 [100,12] [A2,0.5,1]
R12 [12,-1] [10000]
B4 [100,13] [A3,0.5,1]
R13 [13,-1] [10000]
B5 [100,20] [B0,0.5,1]
R20 [20,-1] [10000]
B6 [100,21] [B1,0.5,1]
R21 [21,-1] [10000]
B7 [100,22] [B2,0.5,1]
R22 [22,-1] [10000]
B8 [100,23] [B3,0.5,1]
R23 [23,-1] [10000]
B9 [100,30] [CIN,0.5,1]
R30 [30,-1] [10000]

# ---- FA0: A0,B0,CIN → S0(50), C1(60) ----
U1 [10,20,40] [5,5]
U2 [40,30,50] [5,5]
U3 [10,20,41] [1,5]
U4 [40,30,42] [1,5]
U5 [41,42,60] [3,5]

# ---- FA1: A1,B1,C1 → S1(51), C2(61) ----
U6 [11,21,43] [5,5]
U7 [43,60,51] [5,5]
U8 [11,21,44] [1,5]
U9 [43,60,45] [1,5]
U10 [44,45,61] [3,5]

# ---- FA2: A2,B2,C2 → S2(52), C3(62) ----
U11 [12,22,46] [5,5]
U12 [46,61,52] [5,5]
U13 [12,22,47] [1,5]
U14 [46,61,48] [1,5]
U15 [47,48,62] [3,5]

# ---- FA3: A3,B3,C3 → S3(53), C4(63) ----
U16 [13,23,49] [5,5]
U17 [49,62,53] [5,5]
U18 [13,23,54] [1,5]
U19 [49,62,55] [1,5]
U20 [54,55,63] [3,5]

# 输出负载
R50 [50,-1] [10000]
R51 [51,-1] [10000]
R52 [52,-1] [10000]
R53 [53,-1] [10000]
R63 [63,-1] [10000]
