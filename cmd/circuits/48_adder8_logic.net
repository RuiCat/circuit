# =============================================================================
# 8 位行波进位加法器（adder8，逻辑门实现）
# =============================================================================
# 端口：A[0:7] B[0:7]（两个加数）+ CIN（进位输入）+ S[0:7]（和）+ COUT（进位输出）
# 结构：8 级全加器 fa 级联（行波进位），进位链 CIN→C1→...→C8=COUT
#   每级 FA：S = A⊕B⊕Cin；Cout = A·B + Cin·(A⊕B)
#   全加器用 5 个逻辑门：2×XOR + 2×AND + 1×OR
# 用途：ALU 加法、计数器递增（A=Q, B=1）等
# 验证示例（顶层交互）：
#   A=0110, B=0011, CIN=0 → S=1001, COUT=0
#   A=1111, B=0001, CIN=0 → S=0000, COUT=1（溢出）
# =============================================================================

# ---- 1 位全加器 fa ----
# 端口：A B（本位输入）+ CIN（进位输入）+ S（本位和）+ COUT（进位输出）
#   U1: t1 = A⊕B        （半加和）
#   U2: S  = t1⊕CIN     （本位和）
#   U3: t2 = A·B        （本位生成进位）
#   U4: t3 = (A⊕B)·CIN  （进位传递项）
#   U5: COUT = t2 + t3  （进位输出 = A·B + (A⊕B)·CIN）
.subckt fa A B CIN S COUT
U1 [A,B,t1] [5,5]
U2 [t1,CIN,S] [5,5]
U3 [A,B,t2] [1,5]
U4 [t1,CIN,t3] [1,5]
U5 [t2,t3,COUT] [3,5]
.ends fa

# ---- 8 位行波进位加法器 adder8 ----
# X1..X8：8 级全加器级联，上一级 COUT 接下一级 CIN（行波进位）
.subckt adder8 A[0:7] B[0:7] CIN S[0:7] COUT
X1 [A0,B0,CIN,S0,C1] fa
X2 [A1,B1,C1,S1,C2] fa
X3 [A2,B2,C2,S2,C3] fa
X4 [A3,B3,C3,S3,C4] fa
X5 [A4,B4,C4,S4,C5] fa
X6 [A5,B5,C5,S5,C6] fa
X7 [A6,B6,C6,S6,C7] fa
X8 [A7,B7,C7,S7,COUT] fa
.ends adder8

# =============================================================================
# 顶层演示 —— 交互式开关驱动 adder8
# =============================================================================
# V1：5V 电源；B1..B17：A0..A7 + B0..B7 + CIN 共 17 个事件开关
# R1..R17：各输入 10kΩ 对地下拉（开关断开明确为 0）
# X1：顶层实例化 adder8，和输出 S0..S7、进位 COUT 可直接读节点电压
# =============================================================================
V1 [vcc,-1] [0,0,0,0,5]
B1 [vcc,A0] [A0,0.5,1]
R1 [A0,-1] [10000]
B2 [vcc,A1] [A1,0.5,1]
R2 [A1,-1] [10000]
B3 [vcc,A2] [A2,0.5,1]
R3 [A2,-1] [10000]
B4 [vcc,A3] [A3,0.5,1]
R4 [A3,-1] [10000]
B5 [vcc,A4] [A4,0.5,1]
R5 [A4,-1] [10000]
B6 [vcc,A5] [A5,0.5,1]
R6 [A5,-1] [10000]
B7 [vcc,A6] [A6,0.5,1]
R7 [A6,-1] [10000]
B8 [vcc,A7] [A7,0.5,1]
R8 [A7,-1] [10000]
B9 [vcc,B0] [B0,0.5,1]
R9 [B0,-1] [10000]
B10 [vcc,B1] [B1,0.5,1]
R10 [B1,-1] [10000]
B11 [vcc,B2] [B2,0.5,1]
R11 [B2,-1] [10000]
B12 [vcc,B3] [B3,0.5,1]
R12 [B3,-1] [10000]
B13 [vcc,B4] [B4,0.5,1]
R13 [B4,-1] [10000]
B14 [vcc,B5] [B5,0.5,1]
R14 [B5,-1] [10000]
B15 [vcc,B6] [B6,0.5,1]
R15 [B6,-1] [10000]
B16 [vcc,B7] [B7,0.5,1]
R16 [B7,-1] [10000]
B17 [vcc,CIN] [CIN,0.5,1]
R17 [CIN,-1] [10000]
X1 [A[0:7],B[0:7],CIN,S[0:7],COUT] adder8
R20 [S0,-1] [10000]
R21 [S1,-1] [10000]
R22 [S2,-1] [10000]
R23 [S3,-1] [10000]
R24 [S4,-1] [10000]
R25 [S5,-1] [10000]
R26 [S6,-1] [10000]
R27 [S7,-1] [10000]
R28 [COUT,-1] [10000]
