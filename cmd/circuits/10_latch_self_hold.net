# =============================================================================
# 自锁启停电路 (Self-Holding Latch Circuit)
# =============================================================================
# 拓扑:
#   V1(12V) ──┬──[MB1:停止 常闭]──┬──[MB2:启动 常开]──┬──[RLY1:线圈]──[R1]── GND
#             │                   │                   │
#             │                   └──[B3:自锁 常开]───┘
#             └──[R2:下拉 1MΩ]────────────────────────── GND
#
# 元件:
#   MB1  — 停止按钮 (常闭自复位, holdSteps=3)
#   MB2  — 启动按钮 (常开自复位, holdSteps=50)
#   B3   — 自锁触点 (保持型, 监听 COIL_STATE)
#   RLY1 — 继电器线圈 (生产者, 吸合后回写 COIL_STATE)
#   R1   — 限流 100Ω
#   R2   — 下拉 1MΩ (消除浮空节点)
#   V1   — 12V DC
#
# 操作 (先 step 初始化再 set):
#   > step                    ← 必须先 step 一次
#   > set START_EVENT 1       ← 启动 (MB2闭合 → 线圈得电 → 吸合 → B3自锁)
#   > step ×5                 ← 推进等 MB2 自动弹起 (B3维持导通)
#   > set STOP_EVENT 1        ← 停止 (MB1断开 → 回路断 → 释放)
#   > step ×3                 ← 等 MB1 自动恢复闭合
#
# 运行:
#   circuit interactive cmd/circuits/10_latch_self_hold.net
# =============================================================================

V1 [1, -1] [0, 0, 0, 0, 12]

# 停止按钮 (常闭): 触发断开, 3步后自动恢复闭合
MB1 [1, 2] [STOP_EVENT, 0.5, 0, 1e-6, 1e12, 3]

# 启动按钮 (常开): 触发闭合, 50步后自动弹起 (给线圈吸合时间)
MB2 [2, 3] [START_EVENT, 0.5, 1, 1e-6, 1e12, 50]

# 自锁触点 (保持型): COIL_STATE=1 时持续闭合
B3 [2, 3] [COIL_STATE, 0.5, 1, 1e-6, 1e12]

# 继电器线圈 (生产者): 吸合后回写 COIL_STATE=1
RLY1 [3, 4] [COIL_STATE, 100, 0.01, 0.01, 0.005]

R1 [4, -1] [100]
R2 [2, -1] [1000000]
