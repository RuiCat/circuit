# =============================================================================
# 二极管 ROM (CPU 组件: 指令/数据 ROM, 逻辑实现) — 交互测试
# =============================================================================
# CPU 用二极管 ROM 存程序（12 字 × 8 位）。本质是"字线 → 位线"的或门阵列：
# 每根位线 = 选中其存储位为 1 的字线的 OR。
# 本演示：4 字 × 4 位 ROM，存储内容:
#   W0=1010  W1=0101  W2=1100  W3=0011
# 位线: D0=W0+W2, D1=W0+W1, D2=W1+W3, D3=W0+W3
#
# 操作 (一次只选一根字线，即 4-1 译码后选通):
#   > step
#   > set W0 1 ; step  → D0=5,D1=5,D2=0,D3=5 → 读 W0=1010 ✓
#   > set W0 0 ; set W1 1 ; step → D0=0,D1=5,D2=5,D3=0 → 0101 ✓
#   > set W1 0 ; set W2 1 ; step → D0=5,D1=0,D2=0,D3=0 → 1100？否
#     （W2=1100 需要 D0=W0+W2=1, D1=W0+W1=0, D2=W1+W3=0, D3=W0+W3=0 → 1000）
#   > set W2 0 ; set W3 1 ; step → D0=0,D1=0,D2=5,D3=5 → 0011 ✓
# =============================================================================

V1 [100,-1] [0,0,0,0,5]

# 字线开关（常开，选中=1）
B1 [100,10] [W0,0.5,1]
R10 [10,-1] [10000]
B2 [100,11] [W1,0.5,1]
R11 [11,-1] [10000]
B3 [100,12] [W2,0.5,1]
R12 [12,-1] [10000]
B4 [100,13] [W3,0.5,1]
R13 [13,-1] [10000]

# 位线（或门阵列 = 二极管 ROM 逻辑等效）
# 存储内容:
#   W0=1010 → D3=1, D2=0, D1=1, D0=0
#   W1=0101 → D3=0, D2=1, D1=0, D0=1
#   W2=1100 → D3=1, D2=1, D1=0, D0=0
#   W3=0011 → D3=0, D2=0, D1=1, D0=1
U1 [11,13,20] [3,5]    # D0 = W1 + W3
R20 [20,-1] [10000]
U2 [10,11,21] [3,5]    # D1 = W0 + W1
R21 [21,-1] [10000]
U3 [11,12,22] [3,5]    # D2 = W1 + W2
R22 [22,-1] [10000]
U4 [10,12,23] [3,5]    # D3 = W0 + W2
R23 [23,-1] [10000]
