# =============================================================================
# 8 位多功能 ALU（alu8_full，逻辑门实现）
# =============================================================================
# 端口：S[0:3]（操作选择，直接对应指令 OP）+ A[0:7] + B[0:7] + Y[0:7]
# 操作表：
#   S=0000 LDA  Y=B           S=0001 ADD  Y=A+B          S=0010 SUB  Y=A-B
#   S=0011 AND  Y=A&B         S=0100 OR   Y=A|B          S=0101 XOR  Y=A^B
#   S=0110 NOT  Y=~A          S=0111 SHL  Y=A<<1         S=1000 SHR  Y=A>>1
# 结构：adder8 做 ADD/SUB/LDA（SUB：B 取反+CIN=1；LDA：A=0 → Y=B）
#       AND/OR/XOR 每 bit 阵列；NOT-A；SHL/SHR 硬连线
#       输出 9 选 1：每 bit 9 个使能 AND + OR 树
# =============================================================================

.subckt fa A B CIN S COUT
U1 [A,B,t1] [5,5]
U2 [t1,CIN,S] [5,5]
U3 [A,B,t2] [1,5]
U4 [t1,CIN,t3] [1,5]
U5 [t2,t3,COUT] [3,5]
.ends fa

.subckt adder8 A[0:7] B[0:7] CIN S[0:7] COUT
X1 [A0,B0,CIN,S0,C1] fa
X2 [A1,B1,C1,S1,C2] fa
X3 [A2,B2,C2,S2,C3] fa
X4 [A3,B3,C3,S3,C4] fa
X5 [A4,B4,C4,S4,C5] fa
X6 [A5,B5,C5,S5,C6] fa
X7 [A6,B6,C6,S6,C7] fa
X8 [A7,B7,C7,S7,COUT] fa
.ends adder8

.subckt alu8 S[0:3] A[0:7] B[0:7] Y[0:7]
U1 [S0,-1,nS0] [0,5]
U2 [S1,-1,nS1] [0,5]
U3 [S2,-1,nS2] [0,5]
U4 [S3,-1,nS3] [0,5]
U10a [nS3,nS2,t10a] [1,5]
