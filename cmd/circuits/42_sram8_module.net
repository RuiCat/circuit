# =============================================================================
# sram8 子模块：1 字 × 8 位 SRAM（单 bit 端口）— 供 16×8 阵列重复实例化
# =============================================================================
# 端口：wl(字线) d0..d7(写数据) q0..q7(读输出)；单元 S=d·wl, R=¬d·wl, SR 锁存
# 顶层演示：WL/D0..D7 开关控制，写 1 字 8 位
# 操作:
#   > step
#   > set WL 1 ; set D7 1 ; set D6 0 ; set D5 1 ; set D4 0 ; set D3 1 ; set D2 0 ; set D1 1 ; set D0 0
#   > step ; set WL 0 ; step ; v Q7,Q6,Q5,Q4,Q3,Q2,Q1,Q0  → 10101010
# =============================================================================

V1 [vcc,-1] [0,0,0,0,5]

.subckt sram8 wl d0 d1 d2 d3 d4 d5 d6 d7 q0 q1 q2 q3 q4 q5 q6 q7
U1 [d0,-1,nd0] [0,5]
U2 [d0,wl,s0] [1,5]
U3 [nd0,wl,r0] [1,5]
SR0 [s0,r0,q0,nq0] [5]
R1 [q0,-1] [10000]
U4 [d1,-1,nd1] [0,5]
U5 [d1,wl,s1] [1,5]
U6 [nd1,wl,r1] [1,5]
SR1 [s1,r1,q1,nq1] [5]
R2 [q1,-1] [10000]
U7 [d2,-1,nd2] [0,5]
U8 [d2,wl,s2] [1,5]
U9 [nd2,wl,r2] [1,5]
SR2 [s2,r2,q2,nq2] [5]
R3 [q2,-1] [10000]
U10 [d3,-1,nd3] [0,5]
U11 [d3,wl,s3] [1,5]
U12 [nd3,wl,r3] [1,5]
SR3 [s3,r3,q3,nq3] [5]
R4 [q3,-1] [10000]
U13 [d4,-1,nd4] [0,5]
U14 [d4,wl,s4] [1,5]
U15 [nd4,wl,r4] [1,5]
SR4 [s4,r4,q4,nq4] [5]
R5 [q4,-1] [10000]
U16 [d5,-1,nd5] [0,5]
U17 [d5,wl,s5] [1,5]
U18 [nd5,wl,r5] [1,5]
SR5 [s5,r5,q5,nq5] [5]
R6 [q5,-1] [10000]
U19 [d6,-1,nd6] [0,5]
U20 [d6,wl,s6] [1,5]
U21 [nd6,wl,r6] [1,5]
SR6 [s6,r6,q6,nq6] [5]
R7 [q6,-1] [10000]
U22 [d7,-1,nd7] [0,5]
U23 [d7,wl,s7] [1,5]
U24 [nd7,wl,r7] [1,5]
SR7 [s7,r7,q7,nq7] [5]
R8 [q7,-1] [10000]
.ends sram8

B1 [vcc,wl] [WL,0.5,1]
R9 [wl,-1] [10000]
B2 [vcc,d0] [D0,0.5,1]
R10 [d0,-1] [10000]
B3 [vcc,d1] [D1,0.5,1]
R11 [d1,-1] [10000]
B4 [vcc,d2] [D2,0.5,1]
R12 [d2,-1] [10000]
B5 [vcc,d3] [D3,0.5,1]
R13 [d3,-1] [10000]
B6 [vcc,d4] [D4,0.5,1]
R14 [d4,-1] [10000]
B7 [vcc,d5] [D5,0.5,1]
R15 [d5,-1] [10000]
B8 [vcc,d6] [D6,0.5,1]
R16 [d6,-1] [10000]
B9 [vcc,d7] [D7,0.5,1]
R17 [d7,-1] [10000]

X1 [wl,d0,d1,d2,d3,d4,d5,d6,d7,Q0,Q1,Q2,Q3,Q4,Q5,Q6,Q7] sram8
