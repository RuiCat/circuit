# =============================================================================
# 16×8 位 RAM 模块（ram16x8，模块组合：译码器+锁存器+总线开关）
# =============================================================================
# 端口：A[0:3]（地址总线）+ RW（读/写）+ D[0:7]（输入数据）+ Q[0:7]（输出数据）
#   RW=1：地址选中字写入 D；RW=0：地址选中字输出到 Q
# 结构：decoder4to16 地址译码 → 16 字线；写门控 wlg=WL·RW；
#       16 × sram8 字存储；16 × busswitch8 读选通（高阻总线仲裁）；Q 下拉
# 写协议（必须两步，同真实 SRAM 地址建立时间）：
#   ① 先置好地址 A + 数据 D（此时 RW=0，不写）——等译码器 3 级门传播稳定；
#   ② 再拉 RW=1 写入；③ RW 回 0 保持。
#   若地址与 RW 同时跳变：RW 拉高瞬间旧字线 WL 尚未撤下（译码延迟），
#   wlg=WL_旧·RW 短暂导通 → 相邻字被误写（写竞争），此乃物理时序，非网表 bug。
# =============================================================================

# =============================================================================
# 1 位存储单元 sram_cell —— 字线门控 SR 锁存器（SRAM 位单元）
# =============================================================================
# 端口：
#   wl  = Word Line 字线（写使能）：wl=1 允许写入，wl=0 保持原值
#   bl  = Bit Line 位线（数据输入）
#   nbl = ¬bl 反相位线（数据输入的反相，SR 锁存器需要互补置位/复位）
#   q   = 存储节点正相输出（存的值）
#   nq  = ¬q 存储节点反相输出
# 工作原理：
#   U1：s = bl·wl  → 置位信号（bl=1 且 wl=1 时置位）
#   U2：r = nbl·wl → 复位信号（nbl=1 即 bl=0 且 wl=1 时复位）
#   SR1：SR 锁存器，s 置位 / r 复位，输出 q 与 nq
#   R3/R4：q、nq 对地 10kΩ 弱下拉，防止输入全 0 时节点悬空
#   → wl=1 时 s/r 互补，数据 bl 锁入单元；wl=0 时 s=r=0，锁存器保持记忆
# =============================================================================
.subckt sram_cell wl bl nbl q nq
U1 [bl,wl,s] [1,5]
U2 [nbl,wl,r] [1,5]
SR1 [s,r,q,nq] [5]
R3 [q,-1] [10000]
R4 [nq,-1] [10000]
.ends sram_cell

# =============================================================================
# 8 位锁存器 sram8 —— 一个字的存储（8 × sram_cell 并联）
# =============================================================================
# 端口：RW（写使能，= 该字的字线 wlg）+ D[0:7]（数据输入）+ Q[0:7]（数据输出）
#   U3..U10：每个 D 位经 NOT 门生成反相 nD，供 sram_cell 的 nbl 使用
#   X1..X8：8 个位单元，各自 wl=RW、bl=Di、nbl=nDi，输出 Qi/nqi
#   → RW=1 时整字并行写入 D；RW=0 时整字保持
# =============================================================================
.subckt sram8 RW D[0:7] Q[0:7]
U3 [D0,-1,nD0] [0,5]
U4 [D1,-1,nD1] [0,5]
U5 [D2,-1,nD2] [0,5]
U6 [D3,-1,nD3] [0,5]
U7 [D4,-1,nD4] [0,5]
U8 [D5,-1,nD5] [0,5]
U9 [D6,-1,nD6] [0,5]
U10 [D7,-1,nD7] [0,5]
X1 [RW,D0,nD0,Q0,nq0] sram_cell
X2 [RW,D1,nD1,Q1,nq1] sram_cell
X3 [RW,D2,nD2,Q2,nq2] sram_cell
X4 [RW,D3,nD3,Q3,nq3] sram_cell
X5 [RW,D4,nD4,Q4,nq4] sram_cell
X6 [RW,D5,nD5,Q5,nq5] sram_cell
X7 [RW,D6,nD6,Q6,nq6] sram_cell
X8 [RW,D7,nD7,Q7,nq7] sram_cell
.ends sram8

# =============================================================================
# 4→16 译码器 decoder4to16 —— 地址译码，选中一条字线
# =============================================================================
# 端口：X[0:3]（4 位地址）+ Y[0:15]（16 条字线输出，高电平有效）
# 结构：U1..U4 生成 4 个地址位反相 nX；U5..U52 共 48 个 AND 门，
#       每个输出 Yi = 对应地址最小项（如 Y0=¬X3·¬X2·¬X1·¬X0），
#       三级 AND 树（t*a/t*b 为中间节点）保证任一时刻恰有一条 Yi=5V
# 用途：RAM 的行选择——A=0..15 时对应 WL0..WL15 拉高
# =============================================================================
.subckt decoder4to16 X[0:3] Y[0:15]
U1 [X0,-1,nX0] [0,5]
U2 [X1,-1,nX1] [0,5]
U3 [X2,-1,nX2] [0,5]
U4 [X3,-1,nX3] [0,5]
U5 [nX0,nX1,t0a] [1,5]
U6 [t0a,nX2,t0b] [1,5]
U7 [t0b,nX3,Y0] [1,5]
U8 [X0,nX1,t1a] [1,5]
U9 [t1a,nX2,t1b] [1,5]
U10 [t1b,nX3,Y1] [1,5]
U11 [nX0,X1,t2a] [1,5]
U12 [t2a,nX2,t2b] [1,5]
U13 [t2b,nX3,Y2] [1,5]
U14 [X0,X1,t3a] [1,5]
U15 [t3a,nX2,t3b] [1,5]
U16 [t3b,nX3,Y3] [1,5]
U17 [nX0,nX1,t4a] [1,5]
U18 [t4a,X2,t4b] [1,5]
U19 [t4b,nX3,Y4] [1,5]
U20 [X0,nX1,t5a] [1,5]
U21 [t5a,X2,t5b] [1,5]
U22 [t5b,nX3,Y5] [1,5]
U23 [nX0,X1,t6a] [1,5]
U24 [t6a,X2,t6b] [1,5]
U25 [t6b,nX3,Y6] [1,5]
U26 [X0,X1,t7a] [1,5]
U27 [t7a,X2,t7b] [1,5]
U28 [t7b,nX3,Y7] [1,5]
U29 [nX0,nX1,t8a] [1,5]
U30 [t8a,nX2,t8b] [1,5]
U31 [t8b,X3,Y8] [1,5]
U32 [X0,nX1,t9a] [1,5]
U33 [t9a,nX2,t9b] [1,5]
U34 [t9b,X3,Y9] [1,5]
U35 [nX0,X1,t10a] [1,5]
U36 [t10a,nX2,t10b] [1,5]
U37 [t10b,X3,Y10] [1,5]
U38 [X0,X1,t11a] [1,5]
U39 [t11a,nX2,t11b] [1,5]
U40 [t11b,X3,Y11] [1,5]
U41 [nX0,nX1,t12a] [1,5]
U42 [t12a,X2,t12b] [1,5]
U43 [t12b,X3,Y12] [1,5]
U44 [X0,nX1,t13a] [1,5]
U45 [t13a,X2,t13b] [1,5]
U46 [t13b,X3,Y13] [1,5]
U47 [nX0,X1,t14a] [1,5]
U48 [t14a,X2,t14b] [1,5]
U49 [t14b,X3,Y14] [1,5]
U50 [X0,X1,t15a] [1,5]
U51 [t15a,X2,t15b] [1,5]
U52 [t15b,X3,Y15] [1,5]
.ends decoder4to16

# =============================================================================
# 8 位总线开关 busswitch8 —— 读选通（U 门 + 二极管，真高阻隔离）
# =============================================================================
# 端口：CTRL（字线，行选中）+ X[0:7]（该字存储数据）+ Y[0:7]（公共读数据总线）
# 结构：U60..U67：ti = CTRL·Xi（CTRL=1 时透传该字数据，CTRL=0 时 ti=0）
#       D20..D27：二极管 t→Y，阳极接 t 阴极接 Y
#   → CTRL=1 且 Xi=1：t=5V，二极管导通，Y≈X-0.7V（约 4.3V，有效高电平）
#   → CTRL=0 或 Xi=0：t=0V，二极管反偏截止 → Y 端开路（真高阻，非强拉 0）
# 用途：16 个字共享同一输出总线 Q，只有被选中行（WL=1）的二极管导通驱动总线，
#       其余 15 行全部高阻隔离，避免多个存储字同时驱动总线短路
# =============================================================================
.subckt busswitch8 CTRL X[0:7] Y[0:7]
U60 [CTRL,X0,t0] [1,5]
U61 [CTRL,X1,t1] [1,5]
U62 [CTRL,X2,t2] [1,5]
U63 [CTRL,X3,t3] [1,5]
U64 [CTRL,X4,t4] [1,5]
U65 [CTRL,X5,t5] [1,5]
U66 [CTRL,X6,t6] [1,5]
U67 [CTRL,X7,t7] [1,5]
D20 [t0,Y0] [1e-14,0]
D21 [t1,Y1] [1e-14,0]
D22 [t2,Y2] [1e-14,0]
D23 [t3,Y3] [1e-14,0]
D24 [t4,Y4] [1e-14,0]
D25 [t5,Y5] [1e-14,0]
D26 [t6,Y6] [1e-14,0]
D27 [t7,Y7] [1e-14,0]
.ends busswitch8

# =============================================================================
# 16×8 RAM 顶层模块 ram16x8 —— 全部子电路组合
# =============================================================================
# 端口：A[0:3]（地址）+ RW（读写）+ D[0:7]（写入数据）+ Q[0:7]（读出数据）
# 数据通路（写）：A → 译码出 WL[0:15] → wlg=WL·RW（写门控）→ 选中 sram8 写入 D
# 数据通路（读）：A → WL 选中 → busswitch8 导通 → 该字 q 数据经二极管上 Q 总线
# 各组成部分：
#   X1        ：decoder4to16，A[0:3] → WL[0:15]（16 条字线）
#   U100..U115：写门控 AND，wlg=WL·RW——RW=0 时所有 wlg=0（任何字都不写）
#   X2..X17   ：16 个 sram8 字存储，wlg 作写使能，共享 D 总线，各存 q0..q15
#   X18..X33  ：16 个 busswitch8 读选通，WL 作使能，各字 q 接公共 Q 总线
#   R200..R207：Q 总线 100kΩ 对地下拉——全部字线=0（高阻）时总线拉到 0，
#               与二极管输出形成分压确定读出的高/低电平
# 时序：写必须"先地址+D 稳定、后 RW=1"（见文件头写协议）；
#       读仅需 A 稳定（RW=0 即可，Q 约 4.3V 为有效高电平）
# =============================================================================
.subckt ram16x8 A[0:3] RW D[0:7] Q[0:7]
X1 [A[0:3],WL[0:15]] decoder4to16
U100 [WL0,RW,wlg0] [1,5]
U101 [WL1,RW,wlg1] [1,5]
U102 [WL2,RW,wlg2] [1,5]
U103 [WL3,RW,wlg3] [1,5]
U104 [WL4,RW,wlg4] [1,5]
U105 [WL5,RW,wlg5] [1,5]
U106 [WL6,RW,wlg6] [1,5]
U107 [WL7,RW,wlg7] [1,5]
U108 [WL8,RW,wlg8] [1,5]
U109 [WL9,RW,wlg9] [1,5]
U110 [WL10,RW,wlg10] [1,5]
U111 [WL11,RW,wlg11] [1,5]
U112 [WL12,RW,wlg12] [1,5]
U113 [WL13,RW,wlg13] [1,5]
U114 [WL14,RW,wlg14] [1,5]
U115 [WL15,RW,wlg15] [1,5]
X2 [wlg0,D[0:7],q0[0:7]] sram8
X3 [wlg1,D[0:7],q1[0:7]] sram8
X4 [wlg2,D[0:7],q2[0:7]] sram8
X5 [wlg3,D[0:7],q3[0:7]] sram8
X6 [wlg4,D[0:7],q4[0:7]] sram8
X7 [wlg5,D[0:7],q5[0:7]] sram8
X8 [wlg6,D[0:7],q6[0:7]] sram8
X9 [wlg7,D[0:7],q7[0:7]] sram8
X10 [wlg8,D[0:7],q8[0:7]] sram8
X11 [wlg9,D[0:7],q9[0:7]] sram8
X12 [wlg10,D[0:7],q10[0:7]] sram8
X13 [wlg11,D[0:7],q11[0:7]] sram8
X14 [wlg12,D[0:7],q12[0:7]] sram8
X15 [wlg13,D[0:7],q13[0:7]] sram8
X16 [wlg14,D[0:7],q14[0:7]] sram8
X17 [wlg15,D[0:7],q15[0:7]] sram8
X18 [WL0,q0[0:7],Q[0:7]] busswitch8
X19 [WL1,q1[0:7],Q[0:7]] busswitch8
X20 [WL2,q2[0:7],Q[0:7]] busswitch8
X21 [WL3,q3[0:7],Q[0:7]] busswitch8
X22 [WL4,q4[0:7],Q[0:7]] busswitch8
X23 [WL5,q5[0:7],Q[0:7]] busswitch8
X24 [WL6,q6[0:7],Q[0:7]] busswitch8
X25 [WL7,q7[0:7],Q[0:7]] busswitch8
X26 [WL8,q8[0:7],Q[0:7]] busswitch8
X27 [WL9,q9[0:7],Q[0:7]] busswitch8
X28 [WL10,q10[0:7],Q[0:7]] busswitch8
X29 [WL11,q11[0:7],Q[0:7]] busswitch8
X30 [WL12,q12[0:7],Q[0:7]] busswitch8
X31 [WL13,q13[0:7],Q[0:7]] busswitch8
X32 [WL14,q14[0:7],Q[0:7]] busswitch8
X33 [WL15,q15[0:7],Q[0:7]] busswitch8
R200 [Q0,-1] [100000]
R201 [Q1,-1] [100000]
R202 [Q2,-1] [100000]
R203 [Q3,-1] [100000]
R204 [Q4,-1] [100000]
R205 [Q5,-1] [100000]
R206 [Q6,-1] [100000]
R207 [Q7,-1] [100000]
.ends ram16x8

# =============================================================================
# 顶层演示 —— 交互式开关驱动 ram16x8
# =============================================================================
# V1        ：5V 电源 vcc
# B1..B13   ：13 个事件开关（RW + A0..A3 + D0..D7），CLI/MCP 可 set 0/1 控制
# R1..R13   ：各控制节点 10kΩ 对地下拉——开关断开时节点明确为 0（防悬空）
# X1        ：顶层实例化 ram16x8，接线 A[0:3] RW D[0:7] Q[0:7]
# 交互示例（两步写协议）：
#   set A0=0 A1=0 A2=0 A3=0  D=01011010  RW=0   → 地址 0 + 数据建立
#   set RW=1                                    → 写入地址 0 = 0x5A
#   set RW=0 A=0000                             → 读地址 0，Q=01011010
# =============================================================================
V1 [vcc,-1] [0,0,0,0,5]
B1 [vcc,RW] [RW,0.5,1]
R1 [RW,-1] [10000]
B2 [vcc,A0] [A0,0.5,1]
R2 [A0,-1] [10000]
B3 [vcc,A1] [A1,0.5,1]
R3 [A1,-1] [10000]
B4 [vcc,A2] [A2,0.5,1]
R4 [A2,-1] [10000]
B5 [vcc,A3] [A3,0.5,1]
R5 [A3,-1] [10000]
B6 [vcc,D0] [D0,0.5,1]
R6 [D0,-1] [10000]
B7 [vcc,D1] [D1,0.5,1]
R7 [D1,-1] [10000]
B8 [vcc,D2] [D2,0.5,1]
R8 [D2,-1] [10000]
B9 [vcc,D3] [D3,0.5,1]
R9 [D3,-1] [10000]
B10 [vcc,D4] [D4,0.5,1]
R10 [D4,-1] [10000]
B11 [vcc,D5] [D5,0.5,1]
R11 [D5,-1] [10000]
B12 [vcc,D6] [D6,0.5,1]
R12 [D6,-1] [10000]
B13 [vcc,D7] [D7,0.5,1]
R13 [D7,-1] [10000]
X1 [A[0:3],RW,D[0:7],Q[0:7]] ram16x8
