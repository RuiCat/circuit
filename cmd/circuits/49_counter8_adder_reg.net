# =============================================================================
# 8 位计数器（counter8，加法器 + 寄存器）
# =============================================================================
# 端口：CLK（时钟）+ Q[0:7]（计数值输出）
# 结构：adder8 计算 Q+1（B 恒为 00000001）→ reg8（8×DFF 上升沿采样）→ Q 反馈
#   Q  ──→ adder8(A) ── S=Q+1 ──→ reg8(DFF) ──→ Q
# 每个 CLK 上升沿：Q ← Q+1（0,1,2,...,255,0 循环）
# 用途：CPU 程序计数器 PC 的递增核心
# 验证示例（CLK 1kHz 脉冲）：
#   8 个上升沿后 Q 依次 = 1,2,3,4,5,6,7,8
# =============================================================================

# ---- 1 位全加器 fa（同 adder8 内部） ----
.subckt fa A B CIN S COUT
U1 [A,B,t1] [5,5]
U2 [t1,CIN,S] [5,5]
U3 [A,B,t2] [1,5]
U4 [t1,CIN,t3] [1,5]
U5 [t2,t3,COUT] [3,5]
.ends fa

# ---- 8 位行波进位加法器 adder8 ----
.subckt adder8 A[0:7] B[0:7] CIN S[0:7] COUT
X1 [A0,B0,CIN,S0,C1] fa
X2 [A1,B1,C1,S1,C2] fa
X3 [A2,B2,C2,S2,C3] fa
X4 [A3,B3,C3,S3,C4] fa
X5 [A4,B4,C4,S4,C5] fa
X6 [A5,B5,C5,S5,C6] fa
X7 [A6,B6,C6,S6,C7] fa
X8 [A7,B7,C7,S7,COUT] fa
.ends adder8

# ---- 8 位上升沿 DFF 寄存器 reg8 ----
# 端口：CLK（时钟）+ D[0:7]（输入）+ Q[0:7]（输出）
# DFF1..DFF8：8 个原生 DFF 元件（clk,d,q,nq），CLK 上升沿把 D 锁存到 Q
# R10..R17：nq 反相输出对地 10kΩ 下拉（nq 是内部电压源输出，须挂负载防短路）
.subckt reg8 CLK D[0:7] Q[0:7]
DFF1 [CLK,D0,Q0,nq0]
DFF2 [CLK,D1,Q1,nq1]
DFF3 [CLK,D2,Q2,nq2]
DFF4 [CLK,D3,Q3,nq3]
DFF5 [CLK,D4,Q4,nq4]
DFF6 [CLK,D5,Q5,nq5]
DFF7 [CLK,D6,Q6,nq6]
DFF8 [CLK,D7,Q7,nq7]
R10 [nq0,-1] [10000]
R11 [nq1,-1] [10000]
R12 [nq2,-1] [10000]
R13 [nq3,-1] [10000]
R14 [nq4,-1] [10000]
R15 [nq5,-1] [10000]
R16 [nq6,-1] [10000]
R17 [nq7,-1] [10000]
.ends reg8

# ---- 8 位计数器 counter8 ----
# V1：5V 电源（+1 常数）；Rc8：COUT 悬空保护下拉
# X1：adder8，A=Q（反馈）、B=00000001、CIN=0 → S=Q+1
#     （[0:7] 总线升序展开 A0..A7、B0..B7：B0=1 其余 0 → +1；Q[0:7] 自动对齐）
# X2：reg8，CLK 上升沿采样 S 到 Q（Q 同时反馈回 X1，形成递增环）
.subckt counter8 CLK Q[0:7]
V1 [vcc,-1] [0,0,0,0,5]
R1 [c8,-1] [10000]
R2 [nc,-1] [10000]
X1 [Q[0:7],vcc,-1,-1,-1,-1,-1,-1,-1,nc,S[0:7],c8] adder8
X2 [CLK,S[0:7],Q[0:7]] reg8
.ends counter8

# =============================================================================
# 顶层演示 —— 时钟驱动 counter8
# =============================================================================
# V1：5V 电源 vcc；V2：1kHz 脉冲时钟（幅值 5V，50% 占空比）
# X1：顶层实例化 counter8，Q0..Q7 为计数值输出（Q0 最低位，Q7 最高位）
# 观察：Q0 每时钟翻转、Q1 每 2 时钟、Q2 每 4 时钟…… 8 位二进制计数
# =============================================================================
V1 [vcc,-1] [0,0,0,0,5]
V2 [clk,-1] [5,0,1000,0,5,0.5]
X1 [clk,Q[0:7]] counter8
R10 [Q0,-1] [10000]
R11 [Q1,-1] [10000]
R12 [Q2,-1] [10000]
R13 [Q3,-1] [10000]
R14 [Q4,-1] [10000]
R15 [Q5,-1] [10000]
R16 [Q6,-1] [10000]
R17 [Q7,-1] [10000]
