U43 [t12b,X3,Y12] [1,5]
U44 [X0,nX1,t13a] [1,5]
U45 [t13a,X2,t13b] [1,5]
U46 [t13b,X3,Y13] [1,5]
U47 [nX0,X1,t14a] [1,5]
U48 [t14a,X2,t14b] [1,5]
U49 [t14b,X3,Y14] [1,5]
