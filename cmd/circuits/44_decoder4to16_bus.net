U28 [t7b,nX3,Y7] [1,5]
U29 [nX0,nX1,t8a] [1,5]
U30 [t8a,nX2,t8b] [1,5]
U31 [t8b,X3,Y8] [1,5]
U32 [X0,nX1,t9a] [1,5]
U33 [t9a,nX2,t9b] [1,5]
U34 [t9b,X3,Y9] [1,5]
