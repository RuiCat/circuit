# =============================================================================
# 3-8 译码器 (CPU 组件: 状态译码 B0..B3/T0..T3, 逻辑实现) — 交互测试
# =============================================================================
# CPU 的 3 位计数器输出经 3-8 译码生成 8 个状态线（boot 与执行周期）：
#   Y0=¬A·¬B·¬C, Y1=¬A·¬B·C, ..., Y7=A·B·C（独热输出）
#
# 操作:
#   > step
#   > set A_IN 0 ; set B_IN 0 ; set C_IN 0 ; step  → Y0(30)=5V，其余 0V
#   > set C_IN 1 ; step                            → Y1(31)=5V
#   > set A_IN 1 ; set B_IN 1 ; set C_IN 1 ; step  → Y7(38)=5V
# =============================================================================

V1 [100,-1] [0,0,0,0,5]

# 输入开关 A/B/C
B1 [100,10] [A_IN,0.5,1]
R10 [10,-1] [10000]
B2 [100,11] [B_IN,0.5,1]
R11 [11,-1] [10000]
B3 [100,12] [C_IN,0.5,1]
R12 [12,-1] [10000]

# 反相
U1 [10,-1,20] [0,5]    # ¬A
U2 [11,-1,21] [0,5]    # ¬B
U3 [12,-1,22] [0,5]    # ¬C

# Y0=¬A·¬B·¬C (30)
U4 [20,21,23] [1,5]
U5 [23,22,30] [1,5]
# Y1=¬A·¬B·C (31)
U6 [20,21,24] [1,5]
U7 [24,12,31] [1,5]
# Y2=¬A·B·¬C (32)
U8 [20,11,25] [1,5]
U9 [25,22,32] [1,5]
# Y3=¬A·B·C (33)
U10 [20,11,26] [1,5]
U11 [26,12,33] [1,5]
# Y4=A·¬B·¬C (34)
U12 [10,21,27] [1,5]
U13 [27,22,34] [1,5]
# Y5=A·¬B·C (35)
U14 [10,21,28] [1,5]
U15 [28,12,35] [1,5]
# Y6=A·B·¬C (36)
U16 [10,11,29] [1,5]
U17 [29,22,36] [1,5]
# Y7=A·B·C (38)
U18 [10,11,37] [1,5]
U19 [37,12,38] [1,5]

# 输出负载
R30 [30,-1] [10000]
R31 [31,-1] [10000]
R32 [32,-1] [10000]
R33 [33,-1] [10000]
R34 [34,-1] [10000]
R35 [35,-1] [10000]
R36 [36,-1] [10000]
R38 [38,-1] [10000]
