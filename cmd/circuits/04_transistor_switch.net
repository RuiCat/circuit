# =============================================================================
# NPN 三极管开关电路 (NPN Transistor Switch)
# =============================================================================
# 含非线性元件（NPN 三极管）的电路，展示三极管作为开关的工作原理。
# 基极高电平时三极管饱和导通，集电极电压被拉到接近地。
#
# 电路结构:
#   Vcc(5V) ---+---[R2 1kΩ]---+--- node 3 (集电极/输出)
#              |               |
#            node 100       Q1(NPN)
#                            / \
#             node 2(base)---   --- GND(-1)
#              |
#           [R1 10kΩ]
#              |
#   V2(5V) ---+--- node 1
#
# 工作原理:
#   当基极电压=5V (高电平):
#     Ib ≈ (5 - 0.7) / 10kΩ ≈ 0.43mA
#     Ic_max = Vcc / R2 = 5V / 1kΩ = 5mA
#     饱和条件: β × Ib > Ic_max → 100 × 0.43mA = 43mA > 5mA → 饱和!
#     集电极电压 ≈ 0.2V (Vce_sat)，输出低电平
#
#   当基极电压=0V (低电平):
#     Ib = 0, 三极管截止
#     集电极电压 ≈ 5V (Vcc通过 R2 上拉)，输出高电平
#
# 预期结果:
#   节点 1 = 5V (基极驱动)
#   节点 2 ≈ 0.7V (Vbe 导通压降)
#   节点 3 ≈ 0.2V (Vce_sat，三极管饱和)
#   节点 100 = 5V (Vcc)
#
# 运行命令:
#   circuit -t 0.001 cmd/circuits/04_transistor_switch.net
# =============================================================================

V1 [100,-1] [0,0,0,0,5]     # Vcc 5V DC: 集电极电源
V2 [1,-1] [0,0,0,0,5]       # 基极驱动 5V DC: 高电平使三极管开启
R1 [1,2] [10000]             # 基极电阻 10kΩ: 限制基极电流
R2 [100,3] [1000]            # 集电极电阻 1kΩ: 集电极负载/上拉电阻
Q1 [2,3,-1] [false,100]     # NPN 三极管: base=节点2, collector=节点3, emitter=GND; PNP=false(即NPN), β=100
