# =============================================================================
# RC 低通滤波器 (RC Low-Pass Filter)
# =============================================================================
# 含储能元件（电容）的电路，展示瞬态响应。
# 电阻和电容组成一阶低通滤波器，DC 阶跃输入时电容电压呈指数上升。
#
# 电路结构:
#   V1 (5V DC 阶跃) ---+---[R1 1kΩ]---+--- node 2 --- GND (-1)
#                      |               |
#                    node 1         [C1 1μF]
#                                      |
#                                    GND (-1)
#
# 关键参数:
#   时间常数 τ = R × C = 1000Ω × 1e-6F = 1ms
#   1τ 时: Vc = 5 × (1 - e^-1) ≈ 3.16V (63.2%)
#   2τ 时: Vc ≈ 4.32V (86.5%)
#   3τ 时: Vc ≈ 4.75V (95.0%)
#   5τ 时: Vc ≈ 4.97V (99.3%) — 认为已充满
#   截止频率 fc = 1/(2πRC) ≈ 159Hz
#
# 预期结果:
#   节点 1 = 5V DC（恒定）
#   节点 2 = 从 0V 开始指数上升，~5ms 后接近 5V
#
# 运行命令:
#   circuit -t 0.01 cmd/circuits/02_rc_filter.net
# =============================================================================

V1 [1,-1] [0,0,0,0,5]    # DC 5V 阶跃输入: 波形=0(DC), Vmax=5
R1 [1,2] [1000]           # 电阻 1kΩ: 限制充电电流
C1 [2,-1] [1e-6]          # 电容 1μF: 储能元件，电压不可突变
