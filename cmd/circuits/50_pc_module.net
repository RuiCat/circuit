# =============================================================================
# 8 位程序计数器 PC（pc8，计数器 + 地址修改）
# =============================================================================
# 端口：CLK（时钟）+ LOAD（地址加载）+ A[0:7]（地址修改数据）+ Q[0:7]（PC 值）
# 行为（每个 CLK 上升沿）：
#   LOAD=0：PC ← PC+1           （顺序取指，指向下一条指令）
#   LOAD=1：PC ← A              （跳转/分支：把目标地址写入 PC）
# 结构：
#   adder8(+1) 计算 S=Q+1 → 2:1 多路器 M = LOAD?A:S → reg8(DFF) → Q 反馈
#   Q ──→ adder8 ── S=Q+1 ──┐
#                            ├─ MUX(LOAD) ──→ reg8 ──→ Q
#   A ──────────────────────┘   （LOAD=1 选 A 加载地址）
# 用途：CPU 取指地址源——顺序递增取指令，遇到分支/跳转时 LOAD=1 修改地址
# 验证示例（CLK 1kHz 脉冲）：
#   LOAD=0：Q 每上升沿 +1（0,1,2,...）
#   LOAD=1 且 A=0x2A 时：下一上升沿 Q 直接变为 42，之后恢复 +1 递增
# =============================================================================

# ---- 8 位上升沿 DFF 寄存器 reg8（同 counter8，独立定义便于单文件自足） ----
# 端口：CLK + D[0:7]（输入）+ Q[0:7]（输出），CLK 上升沿锁存
# DFF1..DFF8：8 个原生 DFF 元件（clk,d,q,nq）
# R10..R17：nq 反相输出对地 10kΩ 下拉（nq 是内部电压源输出，须挂负载防短路）
.subckt reg8 CLK D[0:7] Q[0:7]
DFF1 [CLK,D0,Q0,nq0]
DFF2 [CLK,D1,Q1,nq1]
DFF3 [CLK,D2,Q2,nq2]
DFF4 [CLK,D3,Q3,nq3]
DFF5 [CLK,D4,Q4,nq4]
DFF6 [CLK,D5,Q5,nq5]
DFF7 [CLK,D6,Q6,nq6]
DFF8 [CLK,D7,Q7,nq7]
R10 [nq0,-1] [10000]
R11 [nq1,-1] [10000]
R12 [nq2,-1] [10000]
R13 [nq3,-1] [10000]
R14 [nq4,-1] [10000]
R15 [nq5,-1] [10000]
R16 [nq6,-1] [10000]
R17 [nq7,-1] [10000]
.ends reg8

# ---- 1 位全加器 fa（同 adder8 内部） ----
.subckt fa A B CIN S COUT
U1 [A,B,t1] [5,5]
U2 [t1,CIN,S] [5,5]
U3 [A,B,t2] [1,5]
U4 [t1,CIN,t3] [1,5]
U5 [t2,t3,COUT] [3,5]
.ends fa

# ---- 8 位行波进位加法器 adder8 ----
.subckt adder8 A[0:7] B[0:7] CIN S[0:7] COUT
X1 [A0,B0,CIN,S0,C1] fa
X2 [A1,B1,C1,S1,C2] fa
X3 [A2,B2,C2,S2,C3] fa
X4 [A3,B3,C3,S3,C4] fa
X5 [A4,B4,C4,S4,C5] fa
X6 [A5,B5,C5,S5,C6] fa
X7 [A6,B6,C6,S6,C7] fa
X8 [A7,B7,C7,S7,COUT] fa
.ends adder8

# ---- 8 位程序计数器 pc8 ----
# V1：5V 电源（+1 常数）；R1/R2：COUT、CIN 保护下拉
# X1：adder8，A=Q（反馈）、B=00000001、CIN=0 → S=Q+1
#     （[0:7] 总线升序展开 A0..A7、B0..B7：B0=1 其余 0 → +1；Q[0:7] 自动对齐）
# U116：NOT 门，nLOAD = ¬LOAD
# U100..U107：AND 门，ma_i = LOAD·A_i（LOAD=1 时放行地址 A）
# U108..U115：AND 门，ms_i = ¬LOAD·S_i（LOAD=0 时放行递增值 S）
# U117..U124：OR 门，M_i = ma_i + ms_i = LOAD?A_i:S_i（2:1 多路器）
# X2：reg8，CLK 上升沿采样 M 到 Q（Q 反馈回 X1 和 X3 多路器）
.subckt pc8 CLK LOAD A[0:7] Q[0:7]
V1 [vcc,-1] [0,0,0,0,5]
R1 [c8,-1] [10000]
R2 [nc,-1] [10000]
X1 [Q[0:7],vcc,-1,-1,-1,-1,-1,-1,-1,nc,S[0:7],c8] adder8
U116 [LOAD,-1,nLOAD] [0,5]
U100 [LOAD,A0,ma0] [1,5]
U101 [LOAD,A1,ma1] [1,5]
U102 [LOAD,A2,ma2] [1,5]
U103 [LOAD,A3,ma3] [1,5]
U104 [LOAD,A4,ma4] [1,5]
U105 [LOAD,A5,ma5] [1,5]
U106 [LOAD,A6,ma6] [1,5]
U107 [LOAD,A7,ma7] [1,5]
U108 [nLOAD,S0,ms0] [1,5]
U109 [nLOAD,S1,ms1] [1,5]
U110 [nLOAD,S2,ms2] [1,5]
U111 [nLOAD,S3,ms3] [1,5]
U112 [nLOAD,S4,ms4] [1,5]
U113 [nLOAD,S5,ms5] [1,5]
U114 [nLOAD,S6,ms6] [1,5]
U115 [nLOAD,S7,ms7] [1,5]
U117 [ma0,ms0,M0] [3,5]
U118 [ma1,ms1,M1] [3,5]
U119 [ma2,ms2,M2] [3,5]
U120 [ma3,ms3,M3] [3,5]
U121 [ma4,ms4,M4] [3,5]
U122 [ma5,ms5,M5] [3,5]
U123 [ma6,ms6,M6] [3,5]
U124 [ma7,ms7,M7] [3,5]
X2 [CLK,M[0:7],Q[0:7]] reg8
.ends pc8

# =============================================================================
# 顶层演示 —— 时钟 + LOAD/地址开关驱动 pc8
# =============================================================================
# V1：5V 电源 vcc；V2：1kHz 脉冲时钟
# B1..B9：事件开关 LOAD + A0..A7（交互式设置跳转目标地址）
# R1..R9：各输入 10kΩ 对地下拉（开关断开明确为 0）
# X1：顶层实例化 pc8，Q0..Q7 为 PC 值输出
# 操作（circuit interactive cmd/circuits/50_pc_module.net）：
#   > step                     ← 初始化
#   > set LOAD 0 ; step        ← 顺序递增模式，Q 每时钟 +1
#   > set A0 0 A1 1 A2 0 A3 1 A4 0 A5 1 A6 0 A7 0 ; set LOAD 1 ; step
#                              ← 下一时钟 Q 加载为 0x2A（42）
#   > set LOAD 0 ; step        ← 恢复 +1 递增（42,43,44,...）
# =============================================================================
V1 [vcc,-1] [0,0,0,0,5]
V2 [clk,-1] [5,0,1000,0,5,0.5]
B1 [vcc,LOAD] [LOAD,0.5,1]
R1 [LOAD,-1] [10000]
B2 [vcc,A0] [A0,0.5,1]
R2 [A0,-1] [10000]
B3 [vcc,A1] [A1,0.5,1]
R3 [A1,-1] [10000]
B4 [vcc,A2] [A2,0.5,1]
R4 [A2,-1] [10000]
B5 [vcc,A3] [A3,0.5,1]
R5 [A3,-1] [10000]
B6 [vcc,A4] [A4,0.5,1]
R6 [A4,-1] [10000]
B7 [vcc,A5] [A5,0.5,1]
R7 [A5,-1] [10000]
B8 [vcc,A6] [A6,0.5,1]
R8 [A6,-1] [10000]
B9 [vcc,A7] [A7,0.5,1]
R9 [A7,-1] [10000]
X1 [clk,LOAD,A[0:7],Q[0:7]] pc8
R10 [Q0,-1] [10000]
R11 [Q1,-1] [10000]
R12 [Q2,-1] [10000]
R13 [Q3,-1] [10000]
R14 [Q4,-1] [10000]
R15 [Q5,-1] [10000]
R16 [Q6,-1] [10000]
R17 [Q7,-1] [10000]
