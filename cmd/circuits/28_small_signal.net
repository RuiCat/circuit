# 二极管偏置 + 小信号注入 (小信号混合分析)
# 理论: 工作点 Vd≈0.57V, g_d = Is/(N·Vt)·e^(Vd/Vt) ≈ 0.17S
#       V_ac(2) = 0.1·(1/R2)/(1/R2+1/R1+g_d) ≈ 5.8µV, 相位 0°
V1 [1,-1] [0,5,0,0,0]       # DC 5V 偏置 (小信号短路)
R1 [1,2] [1000]             # 偏置电阻
D1 [2,-1] [1e-12,0,1,0,300.15]  # 二极管 Is=1e-12, N=1, Rs=0
V2 [3,-1] [1,0,1000,0,0.1]  # AC 0.1V 信号源 (工作点短路)
R2 [3,2] [100000]           # 信号注入电阻
