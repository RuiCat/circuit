# =============================================================================
# 64 低边开关模块（NPN 功率开关 + 负载，生产级通断控制）
# =============================================================================
# 结构：V1(5V) --(R2 负载 100Ω)-- node3（集电极）
#        Q1：B=node2（经 R1 由 5V 驱动）, C=node3, E=地
#        R1 基极串联电阻 1kΩ（限制基极电流，生产必备）
#
# 生产用途：MCU GPIO 经基极电阻驱动 NPN 通断负载（指示灯/LED 串/小继电器线圈）。
# 设计要点：基极电流 Ib = (Vdrive − Vbe)/Rb = (5−0.7)/1k ≈ 4.3mA；
# 集电极饱和电流 Ic,max = V1/R_load = 50mA；β=100 时 Ib 只需 0.5mA ⇒ 深度饱和，
# 保证 Vce 压降低、器件功耗小（这是"开关"而非"放大"的正确偏置）。
#
# 规格（见 cmd/productionModules_test.go）：
#   S1 导通：Vce < 0.3V（深度饱和；实测 ≈ 2mV）
#   S2 关断：驱动 0V 时 V(集电极) ≥ 4.9V（负载电流 ≈ 0）
#   S3 负载电流：I = (5 − Vce)/100Ω ≈ 50mA
#
# 注：本模块原设计为"低边功率 NMOS"，改用 BJT 的原因见 defects：
#   MOSFET 模型在轻载/饱和区（高阻负载）或 KP ≳ 0.05 时不收敛，
#   或收敛到非物理解（5V 供电下漏极 −6V ~ −26V）——详见
#   runs/circuit-perf-optimization/_results/production-modules/report.md 的 D35。
# =============================================================================
V1 [1,-1] [0,0,0,0,5]        # 5V 电源
R2 [1,3] [100]               # 负载 100Ω（Ic,max = 50mA）
Q1 [2,3,-1] [false,100]      # NPN 开关：B=2, C=3, E=地，β=100
R1 [4,2] [1000]              # 基极串联电阻 1kΩ（Ib ≈ 4.3mA）
V2 [4,-1] [0,0,0,0,5]        # 驱动电平 5V（测试改为 0V 验证关断）
