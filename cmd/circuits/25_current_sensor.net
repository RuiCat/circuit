# =============================================================================
# 电流传感器 (Current Sensor)
# =============================================================================
# 验证电流传感器 CS 元件：测量支路电流，转换为电压输出。
# CS: Vout = gain × I_measured，内部 0V 测量源串入支路。
#
# 电路结构:
#   V1 (5V) → R1(1kΩ) → CS1(in+=2, in-=-1) → 地
#   CS1 输出 (out+=3) → R2 负载
#
# 预期结果:
#   被测电流 = 5V/1kΩ = 5mA
#   Vout = gain(1000) × 5mA = 5V → node3 = 5V
#
# 运行命令:
#   circuit -t 0.001 --nodes 3 cmd/circuits/25_current_sensor.net
# =============================================================================

V1 [1,-1] [0,0,0,0,5]   # 5V 电源
R1 [1,2] [1000]         # 1kΩ 被测支路
CS1 [2,-1,3,-1] [1000,0]  # 电流传感器: in+=2, in-=-1, out+=3, out-=-1; gain=1000
R2 [3,-1] [1000]        # 输出负载
