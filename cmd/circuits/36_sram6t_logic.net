# =============================================================================
# 6T SRAM 单元 (CPU 组件: ramcell, 逻辑实现) — 交互测试
# =============================================================================
# CPU 的 ramcell（6T SRAM）= 交叉耦合 NOR 锁存 + 2 存取管：
#   WL=1 时 BL/NBL 写入 Q/NQ；WL=0 时锁存保持。
# 逻辑实现：S=BL·WL, R=NBL·WL；Q=¬(R∨NQ), NQ=¬(S∨Q)
#
# 操作:
#   > step
#   > set WL_IN 1 ; set BL_IN 1 ; step   → 写入 1 → Q(20)=5V
#   > set WL_IN 0 ; set BL_IN 0 ; step   → 保持 Q=5V（写 0 无效）
#   > set WL_IN 1 ; set BL_IN 0 ; step   → 写入 0 → Q=0V
#   > set WL_IN 0 ; step                → 保持 Q=0V
# =============================================================================

V1 [100,-1] [0,0,0,0,5]

# 输入开关：字线 WL、位线 BL（NBL 由 NOT 派生）
B1 [100,10] [WL_IN,0.5,1]
R10 [10,-1] [10000]
B2 [100,11] [BL_IN,0.5,1]
R11 [11,-1] [10000]

# NBL = ¬BL
U5 [11,-1,12] [0,5]

# 存取门：S=BL·WL, R=NBL·WL
U1 [11,10,13] [1,5]
U2 [12,10,14] [1,5]

# 交叉耦合 NOR 锁存：Q=20, NQ=21
U3 [14,21,20] [4,5]    # NOR(R, NQ) → Q
U4 [13,20,21] [4,5]    # NOR(S, Q) → NQ
R20 [20,-1] [10000]
R21 [21,-1] [10000]
