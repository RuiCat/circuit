# =============================================================================
# 16×8 位 SRAM（多位总线演示：子电路端口 A[3:0]/D[7:0]/Q0[7:0]..Q15[7:0]）
# =============================================================================
# 总线语法：X[name[msb:lsb]] 展开为 name msb..lsb（空格分隔），
# 见 load.ExpandBusNotation。子电路端口可用总线，顶层实例化一行完成。
#
# 操作 (circuit interactive cmd/circuits/41_sram16x8.net):
#   > step
#   --- 写地址 0 (A3A2A1A0=0000) = 0x5A (D7..D0=01011010) ---
#   > set WE 1 ; set A0 0 ; set A1 0 ; set A2 0 ; set A3 0
#   > set D7 0 ; set D6 1 ; set D5 0 ; set D4 1 ; set D3 1 ; set D2 0 ; set D1 1 ; set D0 0
#   > step
#   --- 读地址 0（WE=0 观察 Q0[7:0]）---
#   > set WE 0 ; step ; v Q07,Q06,Q05,Q04,Q03,Q02,Q01,Q00
#     期望 Q0[7:0] = 01011010
#   --- 写地址 5 (0101) = 0xFF 再读 ---
#   > set WE 1 ; set A0 1 ; set A1 0 ; set A2 1 ; set A3 0
#   > set D7 1 ; set D6 1 ; set D5 1 ; set D4 1 ; set D3 1 ; set D2 1 ; set D1 1 ; set D0 1
#   > step ; set WE 0 ; step ; v Q57,Q56,Q55,Q54,Q53,Q52,Q51,Q50
#     期望 Q5[7:0] = 11111111
# =============================================================================

.subckt sram_cell wl bl nbl q nq
U_S [bl,wl,s] [1,5]
U_R [nbl,wl,r] [1,5]
SR1 [s,r,q,nq] [5]
R_Q [q,-1] [10000]
R_NQ [nq,-1] [10000]
.ends sram_cell

.subckt sram16x8 A[3:0] D[7:0] WE Q0[7:0] Q1[7:0] Q2[7:0] Q3[7:0] Q4[7:0] Q5[7:0] Q6[7:0] Q7[7:0] Q8[7:0] Q9[7:0] Q10[7:0] Q11[7:0] Q12[7:0] Q13[7:0] Q14[7:0] Q15[7:0]
# 反相 A0..A3
U_N0 [A0,-1,nA0] [0,5]
U_N1 [A1,-1,nA1] [0,5]
U_N2 [A2,-1,nA2] [0,5]
U_N3 [A3,-1,nA3] [0,5]
# WL[w] = AND(p0,p1,p2,p3)，pi = Ai 或 ¬Ai（按 w 位）
U_D0a [nA0,nA1,t0a] [1,5]
U_D0b [t0a,nA2,t0b] [1,5]
U_D0c [t0b,nA3,WL0] [1,5]
U_D1a [A0,nA1,t1a] [1,5]
U_D1b [t1a,nA2,t1b] [1,5]
U_D1c [t1b,nA3,WL1] [1,5]
U_D2a [nA0,A1,t2a] [1,5]
U_D2b [t2a,nA2,t2b] [1,5]
U_D2c [t2b,nA3,WL2] [1,5]
U_D3a [A0,A1,t3a] [1,5]
U_D3b [t3a,nA2,t3b] [1,5]
U_D3c [t3b,nA3,WL3] [1,5]
U_D4a [nA0,nA1,t4a] [1,5]
U_D4b [t4a,A2,t4b] [1,5]
U_D4c [t4b,nA3,WL4] [1,5]
U_D5a [A0,nA1,t5a] [1,5]
U_D5b [t5a,A2,t5b] [1,5]
U_D5c [t5b,nA3,WL5] [1,5]
U_D6a [nA0,A1,t6a] [1,5]
U_D6b [t6a,A2,t6b] [1,5]
U_D6c [t6b,nA3,WL6] [1,5]
U_D7a [A0,A1,t7a] [1,5]
U_D7b [t7a,A2,t7b] [1,5]
U_D7c [t7b,nA3,WL7] [1,5]
U_D8a [nA0,nA1,t8a] [1,5]
U_D8b [t8a,nA2,t8b] [1,5]
U_D8c [t8b,A3,WL8] [1,5]
U_D9a [A0,nA1,t9a] [1,5]
U_D9b [t9a,nA2,t9b] [1,5]
U_D9c [t9b,A3,WL9] [1,5]
U_D10a [nA0,A1,t10a] [1,5]
U_D10b [t10a,nA2,t10b] [1,5]
U_D10c [t10b,A3,WL10] [1,5]
U_D11a [A0,A1,t11a] [1,5]
U_D11b [t11a,nA2,t11b] [1,5]
U_D11c [t11b,A3,WL11] [1,5]
U_D12a [nA0,nA1,t12a] [1,5]
U_D12b [t12a,A2,t12b] [1,5]
U_D12c [t12b,A3,WL12] [1,5]
U_D13a [A0,nA1,t13a] [1,5]
U_D13b [t13a,A2,t13b] [1,5]
U_D13c [t13b,A3,WL13] [1,5]
U_D14a [nA0,A1,t14a] [1,5]
U_D14b [t14a,A2,t14b] [1,5]
U_D14c [t14b,A3,WL14] [1,5]
U_D15a [A0,A1,t15a] [1,5]
U_D15b [t15a,A2,t15b] [1,5]
U_D15c [t15b,A3,WL15] [1,5]
# WE 门控字线 wlg[w] = WL[w]·WE
U_G0 [WL0,WE,wlg0] [1,5]
U_G1 [WL1,WE,wlg1] [1,5]
U_G2 [WL2,WE,wlg2] [1,5]
U_G3 [WL3,WE,wlg3] [1,5]
U_G4 [WL4,WE,wlg4] [1,5]
U_G5 [WL5,WE,wlg5] [1,5]
U_G6 [WL6,WE,wlg6] [1,5]
U_G7 [WL7,WE,wlg7] [1,5]
U_G8 [WL8,WE,wlg8] [1,5]
U_G9 [WL9,WE,wlg9] [1,5]
U_G10 [WL10,WE,wlg10] [1,5]
U_G11 [WL11,WE,wlg11] [1,5]
U_G12 [WL12,WE,wlg12] [1,5]
U_G13 [WL13,WE,wlg13] [1,5]
U_G14 [WL14,WE,wlg14] [1,5]
U_G15 [WL15,WE,wlg15] [1,5]
# NBL[col] = ¬D[col]
U_NBL0 [D0,-1,nbl0] [0,5]
U_NBL1 [D1,-1,nbl1] [0,5]
U_NBL2 [D2,-1,nbl2] [0,5]
U_NBL3 [D3,-1,nbl3] [0,5]
U_NBL4 [D4,-1,nbl4] [0,5]
U_NBL5 [D5,-1,nbl5] [0,5]
U_NBL6 [D6,-1,nbl6] [0,5]
U_NBL7 [D7,-1,nbl7] [0,5]
# 存储阵列：X{row}_{col} [wlg{row}, D{col}, nbl{col}, Q{row}{col}, nq{row}{col}] sram_cell
X0_0 [wlg0,D0,nbl0,Q00,nq00] sram_cell
X0_1 [wlg0,D1,nbl1,Q01,nq01] sram_cell
