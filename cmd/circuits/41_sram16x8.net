# 5V 电源
V1 [vcc,-1] [0,0,0,0,5]

# 地址开关 A3..A0（总线 A[3:0] 对应节点 A3,A2,A1,A0）
B_A0 [vcc,A0] [A0,0.5,1]
R_A0 [A0,-1] [10000]
B_A1 [vcc,A1] [A1,0.5,1]
R_A1 [A1,-1] [10000]
B_A2 [vcc,A2] [A2,0.5,1]
R_A2 [A2,-1] [10000]
B_A3 [vcc,A3] [A3,0.5,1]
R_A3 [A3,-1] [10000]
# 数据开关 D7..D0
B_D0 [vcc,D0] [D0,0.5,1]
R_D0 [D0,-1] [10000]
B_D1 [vcc,D1] [D1,0.5,1]
R_D1 [D1,-1] [10000]
B_D2 [vcc,D2] [D2,0.5,1]
R_D2 [D2,-1] [10000]
B_D3 [vcc,D3] [D3,0.5,1]
R_D3 [D3,-1] [10000]
B_D4 [vcc,D4] [D4,0.5,1]
R_D4 [D4,-1] [10000]
B_D5 [vcc,D5] [D5,0.5,1]
R_D5 [D5,-1] [10000]
B_D6 [vcc,D6] [D6,0.5,1]
R_D6 [D6,-1] [10000]
B_D7 [vcc,D7] [D7,0.5,1]
R_D7 [D7,-1] [10000]
# 写使能开关
B_WE [vcc,WE] [WE,0.5,1]
R_WE [WE,-1] [10000]

# 顶层实例化：一行完成 16×8 SRAM（总线端口）
X1 [A[3:0],D[7:0],WE,Q0[7:0],Q1[7:0],Q2[7:0],Q3[7:0],Q4[7:0],Q5[7:0],Q6[7:0],Q7[7:0],Q8[7:0],Q9[7:0],Q10[7:0],Q11[7:0],Q12[7:0],Q13[7:0],Q14[7:0],Q15[7:0]] sram16x8
